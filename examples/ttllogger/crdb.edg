let message_size = int(coalesce(env_nil('MESSAGE_SIZE'), 256))

expect {
  error_rate < 1
}

up {
  create_events `CREATE TABLE IF NOT EXISTS events (
      id UUID NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,
      level STRING NOT NULL,
      source STRING NOT NULL,
      message STRING NOT NULL,
      created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
      INDEX idx_events_level_created (level, created_at DESC),
      INDEX idx_events_created (created_at DESC)
    ) WITH (
      ttl_expire_after = '10 minutes',
      ttl_job_cron = '* * * * *'
    )`
}

deseed {
  truncate_events(type: exec) `TRUNCATE TABLE events`
}

down {
  drop_events(type: exec) `DROP TABLE IF EXISTS events`
}

weights {
  read_by_level = 15
  read_recent   = 15
  write_log     = 70
}

run {
  write_log(type: exec) `INSERT INTO events (level, source, message)
    VALUES ($1, $2, $3)` (
    uniform.set(['DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'],[10, 50, 25, 12, 3]),
    uniform.set(['api', 'worker', 'scheduler', 'auth', 'billing'],[]),
    regex('[a-zA-Z0-9 ]{64,256}')
  )

  read_recent(type: query) `SELECT id, level, source, message, created_at
    FROM events
    ORDER BY created_at DESC
    LIMIT 20`

  read_by_level(type: query) `SELECT id, source, message, created_at
    FROM events
    WHERE level = $1
      AND created_at > now() - INTERVAL '5 minutes'
    ORDER BY created_at DESC
    LIMIT 20` (uniform.set(['ERROR', 'WARN', 'FATAL'],[60, 30, 10]))
}
