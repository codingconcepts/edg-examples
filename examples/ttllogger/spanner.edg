let message_size = int(coalesce(env_nil('MESSAGE_SIZE'), 256))

up {
  create_events `CREATE TABLE IF NOT EXISTS events (
      id STRING(36) NOT NULL DEFAULT (GENERATE_UUID()),
      level STRING(10) NOT NULL,
      source STRING(50) NOT NULL,
      message STRING(MAX) NOT NULL,
      created_at TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP())
    ) PRIMARY KEY (id)`

  create_idx_events_level_created `CREATE INDEX IF NOT EXISTS idx_events_level_created
    ON events (level, created_at DESC)`

  create_idx_events_created `CREATE INDEX IF NOT EXISTS idx_events_created
    ON events (created_at DESC)`
}

weights {
  cleanup_expired = 10
  read_by_level   = 15
  read_recent     = 15
  write_log       = 60
}

run {
  write_log(type: exec) `INSERT INTO events (level, source, message)
    VALUES (@p1, @p2, @p3)` (
    uniform.set(['DEBUG', 'INFO', 'WARN', 'ERROR', 'FATAL'],[10, 50, 25, 12, 3]),
    uniform.set(['api', 'worker', 'scheduler', 'auth', 'billing'],[]),
    regex('[a-zA-Z0-9 ]{64,256}')
  )

  read_recent(type: query) `SELECT id, level, source, message, created_at
    FROM events
    ORDER BY created_at DESC
    LIMIT 20`

  read_by_level(type: query) `SELECT id, source, message, created_at
    FROM events
    WHERE level = @p1
      AND created_at > TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 5 MINUTE)
    ORDER BY created_at DESC
    LIMIT 20` (uniform.set(['ERROR', 'WARN', 'FATAL'],[60, 30, 10]))

  cleanup_expired(type: exec) `DELETE FROM events
    WHERE created_at < TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 10 MINUTE)`
}

deseed {
  delete_events(type: exec) `DELETE FROM events WHERE TRUE`
}

down {
  drop_idx_events_level_created(type: exec) `DROP INDEX IF EXISTS idx_events_level_created`

  drop_idx_events_created(type: exec) `DROP INDEX IF EXISTS idx_events_created`

  drop_events(type: exec) `DROP TABLE IF EXISTS events`
}

expect {
  error_rate < 1
}
