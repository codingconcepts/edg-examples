let keys       = int(coalesce(env_nil('KEYS'), 1000))
let batch_size = int(coalesce(env_nil('BATCH_SIZE'), 100))
let value_size = int(coalesce(env_nil('VALUE_SIZE'), 256))

expect {
  error_rate < 1
}

up {
  create_kv `IF OBJECT_ID('kv', 'U') IS NULL
    CREATE TABLE kv (
      k BIGINT NOT NULL PRIMARY KEY,
      v VARBINARY(MAX) NOT NULL
    )`
}

seed {
  populate_kv `WITH seq AS (
      SELECT 1 AS s
      UNION ALL
      SELECT s + 1 FROM seq WHERE s < $2
    )
    INSERT INTO kv (k, v)
    SELECT
      $1 * $2 + s,
      CRYPT_GEN_RANDOM($3)
    FROM seq
    OPTION (MAXRECURSION 10000)` (
    batch(keys / batch_size),
    batch_size,
    value_size
  )
}

deseed {
  delete_kv(type: exec) `DELETE FROM kv`
}

down {
  drop_kv(type: exec) `DROP TABLE IF EXISTS kv`
}

weights {
  read  = 50
  write = 50
}

run {
  read(type: query) `SELECT k, v FROM kv WHERE k = @p1` (gen('number:1,' + string(keys)))

  write(type: exec) `MERGE kv AS t
    USING (SELECT @p1 AS k, @p2 AS v) AS s
    ON t.k = s.k
    WHEN MATCHED THEN UPDATE SET t.v = s.v
    WHEN NOT MATCHED THEN INSERT (k, v) VALUES (s.k, s.v);` (
    gen('number:1,' + string(keys)),
    blob(value_size)
  )
}
