let keys       = int(coalesce(env_nil('KEYS'), 1000))
let batch_size = int(coalesce(env_nil('BATCH_SIZE'), 100))
let value_size = int(coalesce(env_nil('VALUE_SIZE'), 256))

up {
  create_keyspace(type: exec) `CREATE KEYSPACE IF NOT EXISTS edg
    WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1}`

  create_kv(type: exec) `CREATE TABLE IF NOT EXISTS edg.kv (
      k BIGINT PRIMARY KEY,
      v BLOB
    )`
}

seed {
  populate_kv(type: exec_batch, count: keys, size: 50) `INSERT INTO edg.kv (k, v) VALUES ($1, $2)` (
    seq(1, 1),
    blob(value_size)
  )
}

weights {
  read  = 50
  write = 50
}

run {
  read(type: query) `SELECT k, v FROM edg.kv WHERE k = $1` (gen('number:1,' + string(keys)))

  write(type: exec) `INSERT INTO edg.kv (k, v) VALUES ($1, $2)` (
    gen('number:1,' + string(keys)),
    blob(value_size)
  )
}

deseed {
  truncate_kv(type: exec) `TRUNCATE edg.kv`
}

down {
  drop_kv(type: exec) `DROP TABLE IF EXISTS edg.kv`

  drop_keyspace(type: exec) `DROP KEYSPACE IF EXISTS edg`
}

expect {
  error_rate < 1
}
