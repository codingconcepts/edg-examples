include 'targets.edg'

let users       = 10000
let batch_size  = 1000
let fetch_limit = batch_size

# The SQL below is deliberately portable across CockroachDB and
# Postgres, because both targets run it unchanged. Two databases that
# need different SQL get a `config` each on their target instead - see
# examples/compare.
up {
  create_users `CREATE TABLE IF NOT EXISTS users (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      email TEXT NOT NULL
    )`
}

seed {
  populate_users(type: exec_batch, count: users, size: batch_size) `INSERT INTO users (email)
    __values__` (gen('email'))
}

init {
  fetch_users `SELECT id, email FROM users LIMIT $1` (fetch_limit)
}

run {
  get_user `SELECT * FROM users WHERE id = $1` (ref('fetch_users').id)

  update_email `UPDATE users SET email = $2 WHERE id = $1` (
    ref('fetch_users').id,
    gen('email')
  )
}

deseed {
  truncate_users(type: exec) `TRUNCATE TABLE users CASCADE`
}

down {
  drop_users(type: exec) `DROP TABLE IF EXISTS users`
}
