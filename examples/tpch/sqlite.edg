let scale_factor = int(coalesce(env_nil('SCALE_FACTOR'), 1))
let regions      = int(coalesce(env_nil('REGIONS'), 5))
let nations      = int(coalesce(env_nil('NATIONS'), 25))
let suppliers    = int(coalesce(env_nil('SUPPLIERS'), 100))
let parts        = int(coalesce(env_nil('PARTS'), 200))
let customers    = int(coalesce(env_nil('CUSTOMERS'), 150))
let orders       = int(coalesce(env_nil('ORDERS'), 1000))
let batch_size   = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_region `CREATE TABLE IF NOT EXISTS region (
      r_regionkey INTEGER NOT NULL PRIMARY KEY,
      r_name TEXT NOT NULL,
      r_comment TEXT
    )`

  create_nation `CREATE TABLE IF NOT EXISTS nation (
      n_nationkey INTEGER NOT NULL PRIMARY KEY,
      n_name TEXT NOT NULL,
      n_regionkey INTEGER NOT NULL,
      n_comment TEXT
    )`

  create_supplier `CREATE TABLE IF NOT EXISTS supplier (
      s_suppkey INTEGER NOT NULL PRIMARY KEY,
      s_name TEXT NOT NULL,
      s_address TEXT NOT NULL,
      s_nationkey INTEGER NOT NULL,
      s_phone TEXT NOT NULL,
      s_acctbal REAL NOT NULL,
      s_comment TEXT
    )`

  create_part `CREATE TABLE IF NOT EXISTS part (
      p_partkey INTEGER NOT NULL PRIMARY KEY,
      p_name TEXT NOT NULL,
      p_mfgr TEXT NOT NULL,
      p_brand TEXT NOT NULL,
      p_type TEXT NOT NULL,
      p_size INTEGER NOT NULL,
      p_container TEXT NOT NULL,
      p_retailprice REAL NOT NULL,
      p_comment TEXT
    )`

  create_partsupp `CREATE TABLE IF NOT EXISTS partsupp (
      ps_partkey INTEGER NOT NULL,
      ps_suppkey INTEGER NOT NULL,
      ps_availqty INTEGER NOT NULL,
      ps_supplycost REAL NOT NULL,
      ps_comment TEXT,
      PRIMARY KEY (ps_partkey, ps_suppkey)
    )`

  create_customer `CREATE TABLE IF NOT EXISTS customer (
      c_custkey INTEGER NOT NULL PRIMARY KEY,
      c_name TEXT NOT NULL,
      c_address TEXT NOT NULL,
      c_nationkey INTEGER NOT NULL,
      c_phone TEXT NOT NULL,
      c_acctbal REAL NOT NULL,
      c_mktsegment TEXT NOT NULL,
      c_comment TEXT
    )`

  create_orders `CREATE TABLE IF NOT EXISTS orders (
      o_orderkey INTEGER NOT NULL PRIMARY KEY,
      o_custkey INTEGER NOT NULL,
      o_orderstatus TEXT NOT NULL,
      o_totalprice REAL NOT NULL,
      o_orderdate DATE NOT NULL,
      o_orderpriority TEXT NOT NULL,
      o_clerk TEXT NOT NULL,
      o_shippriority INTEGER NOT NULL,
      o_comment TEXT
    )`

  create_lineitem `CREATE TABLE IF NOT EXISTS lineitem (
      l_orderkey INTEGER NOT NULL,
      l_partkey INTEGER NOT NULL,
      l_suppkey INTEGER NOT NULL,
      l_linenumber INTEGER NOT NULL,
      l_quantity REAL NOT NULL,
      l_extendedprice REAL NOT NULL,
      l_discount REAL NOT NULL,
      l_tax REAL NOT NULL,
      l_returnflag TEXT NOT NULL,
      l_linestatus TEXT NOT NULL,
      l_shipdate DATE NOT NULL,
      l_commitdate DATE NOT NULL,
      l_receiptdate DATE NOT NULL,
      l_shipinstruct TEXT NOT NULL,
      l_shipmode TEXT NOT NULL,
      l_comment TEXT,
      PRIMARY KEY (l_orderkey, l_linenumber)
    )`
}

seed {
  populate_region `INSERT INTO region (r_regionkey, r_name, r_comment) VALUES
      (0,'AFRICA',''), (1,'AMERICA',''), (2,'ASIA',''),
      (3,'EUROPE',''), (4,'MIDDLE EAST','')`

  populate_nation `INSERT INTO nation (n_nationkey, n_name, n_regionkey, n_comment) VALUES
      (0,'ALGERIA',0,''),    (1,'ARGENTINA',1,''),  (2,'BRAZIL',1,''),
      (3,'CANADA',1,''),     (4,'EGYPT',4,''),      (5,'ETHIOPIA',0,''),
      (6,'FRANCE',3,''),     (7,'GERMANY',3,''),    (8,'INDIA',2,''),
      (9,'INDONESIA',2,''),  (10,'IRAN',4,''),      (11,'IRAQ',4,''),
      (12,'JAPAN',2,''),     (13,'JORDAN',4,''),    (14,'KENYA',0,''),
      (15,'MOROCCO',0,''),   (16,'MOZAMBIQUE',0,''), (17,'PERU',1,''),
      (18,'CHINA',2,''),     (19,'ROMANIA',3,''),   (20,'SAUDI ARABIA',4,''),
      (21,'VIETNAM',2,''),   (22,'RUSSIA',3,''),    (23,'UNITED KINGDOM',3,''),
      (24,'UNITED STATES',1,'')`

  populate_supplier `INSERT INTO supplier (s_suppkey, s_name, s_address, s_nationkey,
      s_phone, s_acctbal, s_comment)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $1
    )
    SELECT s,
      'Supplier#' || substr('000000000' || s, -9),
      substr(hex(randomblob(20)), 1, abs(random()) % 25 + 15),
      abs(random()) % 25,
      substr('0' || (abs(random()) % 90 + 10), -2) || '-' ||
        substr('000' || (abs(random()) % 1000), -3) || '-' ||
        substr('000' || (abs(random()) % 1000), -3) || '-' ||
        substr('0000' || (abs(random()) % 10000), -4),
      round(abs(random()) % 1000000 / 1000000.0 * 10000 - 1000, 2),
      substr(hex(randomblob(16)), 1, 30)
    FROM seq` (suppliers)

  populate_part `INSERT INTO part (p_partkey, p_name, p_mfgr, p_brand, p_type,
      p_size, p_container, p_retailprice, p_comment)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    SELECT $1 * $2 + s,
      substr(hex(randomblob(32)), 1, abs(random()) % 30 + 20),
      'Manufacturer#' || (abs(random()) % 5 + 1),
      'Brand#' || (abs(random()) % 5 + 1) || (abs(random()) % 5 + 1),
      CASE abs(random()) % 6
        WHEN 0 THEN 'STANDARD' WHEN 1 THEN 'SMALL'   WHEN 2 THEN 'MEDIUM'
        WHEN 3 THEN 'LARGE'    WHEN 4 THEN 'ECONOMY' ELSE 'PROMO'
      END,
      abs(random()) % 50 + 1,
      CASE abs(random()) % 10
        WHEN 0 THEN 'SM CASE'  WHEN 1 THEN 'SM BOX'   WHEN 2 THEN 'SM PACK'
        WHEN 3 THEN 'MED CASE' WHEN 4 THEN 'MED BOX'  WHEN 5 THEN 'MED PACK'
        WHEN 6 THEN 'LG CASE'  WHEN 7 THEN 'LG BOX'   WHEN 8 THEN 'LG PACK'
        ELSE 'WRAP BOX'
      END,
      round((90000 + ($1 * $2 + s) / 10.0 + abs(random()) % 1000000 / 1000000.0 * 100) / 100.0, 2),
      substr(hex(randomblob(16)), 1, 15)
    FROM seq` (
    batch(parts / batch_size),
    batch_size
  )

  populate_customer `INSERT INTO customer (c_custkey, c_name, c_address, c_nationkey,
      c_phone, c_acctbal, c_mktsegment, c_comment)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    SELECT $1 * $2 + s,
      'Customer#' || substr('000000000' || ($1 * $2 + s), -9),
      substr(hex(randomblob(20)), 1, abs(random()) % 25 + 15),
      abs(random()) % 25,
      substr('0' || (abs(random()) % 90 + 10), -2) || '-' ||
        substr('000' || (abs(random()) % 1000), -3) || '-' ||
        substr('000' || (abs(random()) % 1000), -3) || '-' ||
        substr('0000' || (abs(random()) % 10000), -4),
      round(abs(random()) % 1000000 / 1000000.0 * 10000 - 1000, 2),
      CASE abs(random()) % 5
        WHEN 0 THEN 'AUTOMOBILE' WHEN 1 THEN 'BUILDING'  WHEN 2 THEN 'FURNITURE'
        WHEN 3 THEN 'MACHINERY'  ELSE 'HOUSEHOLD'
      END,
      substr(hex(randomblob(24)), 1, 40)
    FROM seq` (
    batch(customers / batch_size),
    batch_size
  )

  populate_orders `INSERT INTO orders (o_orderkey, o_custkey, o_orderstatus,
      o_totalprice, o_orderdate, o_orderpriority, o_clerk,
      o_shippriority, o_comment)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    SELECT $1 * $2 + s,
      abs(random()) % $3 + 1,
      CASE abs(random()) % 3 WHEN 0 THEN 'O' WHEN 1 THEN 'F' ELSE 'P' END,
      round(abs(random()) % 1000000 / 1000000.0 * 400000 + 1000, 2),
      date('1992-01-01', '+' || (abs(random()) % 2557) || ' days'),
      CASE abs(random()) % 5
        WHEN 0 THEN '1-URGENT'        WHEN 1 THEN '2-HIGH' WHEN 2 THEN '3-MEDIUM'
        WHEN 3 THEN '4-NOT SPECIFIED' ELSE '5-LOW'
      END,
      'Clerk#' || substr('000000000' || (abs(random()) % 1000 + 1), -9),
      0,
      substr(hex(randomblob(16)), 1, 30)
    FROM seq` (
    batch(orders / batch_size),
    batch_size,
    customers
  )

  populate_lineitem `INSERT INTO lineitem (l_orderkey, l_partkey, l_suppkey, l_linenumber,
      l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag,
      l_linestatus, l_shipdate, l_commitdate, l_receiptdate,
      l_shipinstruct, l_shipmode, l_comment)
    SELECT
      o.o_orderkey,
      abs(random()) % $3 + 1,
      abs(random()) % $4 + 1,
      1,
      round(abs(random()) % 1000000 / 1000000.0 * 50 + 1, 2),
      round(abs(random()) % 1000000 / 1000000.0 * 90000 + 1000, 2),
      round(abs(random()) % 1000000 / 1000000.0 * 0.10, 2),
      round(abs(random()) % 1000000 / 1000000.0 * 0.08, 2),
      CASE abs(random()) % 3 WHEN 0 THEN 'R' WHEN 1 THEN 'A' ELSE 'N' END,
      CASE abs(random()) % 2 WHEN 0 THEN 'O' ELSE 'F' END,
      date(o.o_orderdate, '+' || (abs(random()) % 120 + 1) || ' days'),
      date(o.o_orderdate, '+' || (abs(random()) % 90 + 1) || ' days'),
      date(o.o_orderdate, '+' || (abs(random()) % 150 + 1) || ' days'),
      CASE abs(random()) % 4
        WHEN 0 THEN 'DELIVER IN PERSON' WHEN 1 THEN 'COLLECT COD'
        WHEN 2 THEN 'NONE'              ELSE 'TAKE BACK RETURN'
      END,
      CASE abs(random()) % 7
        WHEN 0 THEN 'REG AIR' WHEN 1 THEN 'AIR'  WHEN 2 THEN 'RAIL'
        WHEN 3 THEN 'SHIP'    WHEN 4 THEN 'TRUCK' WHEN 5 THEN 'MAIL'
        ELSE 'FOB'
      END,
      substr(hex(randomblob(16)), 1, 20)
    FROM orders o
    WHERE o.o_orderkey > $1 * $2
      AND o.o_orderkey <= ($1 + 1) * $2` (
    batch(orders / batch_size),
    batch_size,
    parts,
    suppliers
  )
}

weights {
  q14_promotion_effect   = 25
  q1_pricing_summary     = 25
  q3_shipping_priority   = 25
  q6_forecasting_revenue = 25
}

run {
  q1_pricing_summary(type: query) `SELECT
      l_returnflag, l_linestatus,
      SUM(l_quantity) AS sum_qty,
      SUM(l_extendedprice) AS sum_base_price,
      SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
      SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
      AVG(l_quantity) AS avg_qty,
      AVG(l_extendedprice) AS avg_price,
      AVG(l_discount) AS avg_disc,
      COUNT(*) AS count_order
    FROM lineitem
    WHERE l_shipdate <= date('1998-12-01', '-' || ? || ' days')
    GROUP BY l_returnflag, l_linestatus
    ORDER BY l_returnflag, l_linestatus` (gen('number:60,120'))

  q3_shipping_priority(type: query) `SELECT
      l.l_orderkey,
      SUM(l.l_extendedprice * (1 - l.l_discount)) AS revenue,
      o.o_orderdate, o.o_shippriority
    FROM customer c
    JOIN orders o ON c.c_custkey = o.o_custkey
    JOIN lineitem l ON l.l_orderkey = o.o_orderkey
    WHERE c.c_mktsegment = ?
      AND o.o_orderdate < date('1995-03-01', '+' || ? || ' days')
      AND l.l_shipdate > date('1995-03-01', '+' || ? || ' days')
    GROUP BY l.l_orderkey, o.o_orderdate, o.o_shippriority
    ORDER BY revenue DESC, o.o_orderdate
    LIMIT 10` (
    uniform.set(['AUTOMOBILE', 'BUILDING', 'FURNITURE', 'MACHINERY', 'HOUSEHOLD'],[]),
    gen('number:1,31'),
    gen('number:1,31')
  )

  q6_forecasting_revenue(type: query) `SELECT SUM(l_extendedprice * l_discount) AS revenue
    FROM lineitem
    WHERE l_shipdate >= ? || '-01-01'
      AND l_shipdate < date(? || '-01-01', '+1 year')
      AND l_discount BETWEEN ? - 0.01 AND ? + 0.01
      AND l_quantity < ?` (
    gen('number:1993,1997'),
    gen('number:1993,1997'),
    uniform.float(0.02, 0.09, 2),
    uniform.float(0.02, 0.09, 2),
    gen('number:24,25')
  )

  q14_promotion_effect(type: query) `SELECT
      100.00 * SUM(CASE WHEN p.p_type LIKE 'PROMO%'
        THEN l.l_extendedprice * (1 - l.l_discount) ELSE 0 END)
      / SUM(l.l_extendedprice * (1 - l.l_discount)) AS promo_revenue
    FROM lineitem l
    JOIN part p ON l.l_partkey = p.p_partkey
    WHERE l_shipdate >= ? || '-' || substr('0' || ?, -2) || '-01'
      AND l_shipdate < date(? || '-' || substr('0' || ?, -2) || '-01', '+1 month')` (
    gen('number:1993,1997'),
    gen('number:1,12'),
    gen('number:1993,1997'),
    gen('number:1,12')
  )
}

deseed {
  delete_lineitem(type: exec) `DELETE FROM lineitem`

  delete_orders(type: exec) `DELETE FROM orders`

  delete_partsupp(type: exec) `DELETE FROM partsupp`

  delete_customer(type: exec) `DELETE FROM customer`

  delete_part(type: exec) `DELETE FROM part`

  delete_supplier(type: exec) `DELETE FROM supplier`

  delete_nation(type: exec) `DELETE FROM nation`

  delete_region(type: exec) `DELETE FROM region`
}

down {
  drop_lineitem(type: exec) `DROP TABLE IF EXISTS lineitem`

  drop_orders(type: exec) `DROP TABLE IF EXISTS orders`

  drop_partsupp(type: exec) `DROP TABLE IF EXISTS partsupp`

  drop_customer(type: exec) `DROP TABLE IF EXISTS customer`

  drop_part(type: exec) `DROP TABLE IF EXISTS part`

  drop_supplier(type: exec) `DROP TABLE IF EXISTS supplier`

  drop_nation(type: exec) `DROP TABLE IF EXISTS nation`

  drop_region(type: exec) `DROP TABLE IF EXISTS region`
}

expect {
  error_rate < 1
}
