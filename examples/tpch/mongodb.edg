let scale_factor = int(coalesce(env_nil('SCALE_FACTOR'), 1))
let regions      = int(coalesce(env_nil('REGIONS'), 5))
let nations      = int(coalesce(env_nil('NATIONS'), 25))
let suppliers    = int(coalesce(env_nil('SUPPLIERS'), 100))
let parts        = int(coalesce(env_nil('PARTS'), 200))
let customers    = int(coalesce(env_nil('CUSTOMERS'), 150))
let orders       = int(coalesce(env_nil('ORDERS'), 1000))
let batch_size   = int(coalesce(env_nil('BATCH_SIZE'), 100))

expect {
  error_rate < 1
}

up {
  create_region(type: exec) `{"create": "region"}`

  create_nation(type: exec) `{"create": "nation"}`

  create_supplier(type: exec) `{"create": "supplier"}`

  create_part(type: exec) `{"create": "part"}`

  create_partsupp(type: exec) `{"create": "partsupp"}`

  create_customer(type: exec) `{"create": "customer"}`

  create_orders(type: exec) `{"create": "orders"}`

  create_lineitem(type: exec) `{"create": "lineitem"}`

  create_idx_lineitem_orderkey(type: exec) `{"createIndexes": "lineitem", "indexes": [{"key": {"l_orderkey": 1}, "name": "idx_lineitem_orderkey"}]}`

  create_idx_lineitem_partkey(type: exec) `{"createIndexes": "lineitem", "indexes": [{"key": {"l_partkey": 1}, "name": "idx_lineitem_partkey"}]}`

  create_idx_lineitem_shipdate(type: exec) `{"createIndexes": "lineitem", "indexes": [{"key": {"l_shipdate": 1}, "name": "idx_lineitem_shipdate"}]}`

  create_idx_orders_custkey(type: exec) `{"createIndexes": "orders", "indexes": [{"key": {"o_custkey": 1}, "name": "idx_orders_custkey"}]}`

  create_idx_customer_mktsegment(type: exec) `{"createIndexes": "customer", "indexes": [{"key": {"c_mktsegment": 1}, "name": "idx_customer_mktsegment"}]}`
}

seed {
  populate_region(type: exec) `{"insert": "region", "documents": [
      {"_id": 0, "r_regionkey": 0, "r_name": "AFRICA", "r_comment": "ref"},
      {"_id": 1, "r_regionkey": 1, "r_name": "AMERICA", "r_comment": "ref"},
      {"_id": 2, "r_regionkey": 2, "r_name": "ASIA", "r_comment": "ref"},
      {"_id": 3, "r_regionkey": 3, "r_name": "EUROPE", "r_comment": "ref"},
      {"_id": 4, "r_regionkey": 4, "r_name": "MIDDLE EAST", "r_comment": "ref"}
    ]}`

  populate_nation(type: exec) `{"insert": "nation", "documents": [
      {"_id": 0, "n_nationkey": 0, "n_name": "ALGERIA", "n_regionkey": 0, "n_comment": ""},
      {"_id": 1, "n_nationkey": 1, "n_name": "ARGENTINA", "n_regionkey": 1, "n_comment": ""},
      {"_id": 2, "n_nationkey": 2, "n_name": "BRAZIL", "n_regionkey": 1, "n_comment": ""},
      {"_id": 3, "n_nationkey": 3, "n_name": "CANADA", "n_regionkey": 1, "n_comment": ""},
      {"_id": 4, "n_nationkey": 4, "n_name": "EGYPT", "n_regionkey": 4, "n_comment": ""},
      {"_id": 5, "n_nationkey": 5, "n_name": "ETHIOPIA", "n_regionkey": 0, "n_comment": ""},
      {"_id": 6, "n_nationkey": 6, "n_name": "FRANCE", "n_regionkey": 3, "n_comment": ""},
      {"_id": 7, "n_nationkey": 7, "n_name": "GERMANY", "n_regionkey": 3, "n_comment": ""},
      {"_id": 8, "n_nationkey": 8, "n_name": "INDIA", "n_regionkey": 2, "n_comment": ""},
      {"_id": 9, "n_nationkey": 9, "n_name": "INDONESIA", "n_regionkey": 2, "n_comment": ""},
      {"_id": 10, "n_nationkey": 10, "n_name": "IRAN", "n_regionkey": 4, "n_comment": ""},
      {"_id": 11, "n_nationkey": 11, "n_name": "IRAQ", "n_regionkey": 4, "n_comment": ""},
      {"_id": 12, "n_nationkey": 12, "n_name": "JAPAN", "n_regionkey": 2, "n_comment": ""},
      {"_id": 13, "n_nationkey": 13, "n_name": "JORDAN", "n_regionkey": 4, "n_comment": ""},
      {"_id": 14, "n_nationkey": 14, "n_name": "KENYA", "n_regionkey": 0, "n_comment": ""},
      {"_id": 15, "n_nationkey": 15, "n_name": "MOROCCO", "n_regionkey": 0, "n_comment": ""},
      {"_id": 16, "n_nationkey": 16, "n_name": "MOZAMBIQUE", "n_regionkey": 0, "n_comment": ""},
      {"_id": 17, "n_nationkey": 17, "n_name": "PERU", "n_regionkey": 1, "n_comment": ""},
      {"_id": 18, "n_nationkey": 18, "n_name": "CHINA", "n_regionkey": 2, "n_comment": ""},
      {"_id": 19, "n_nationkey": 19, "n_name": "ROMANIA", "n_regionkey": 3, "n_comment": ""},
      {"_id": 20, "n_nationkey": 20, "n_name": "SAUDI ARABIA", "n_regionkey": 4, "n_comment": ""},
      {"_id": 21, "n_nationkey": 21, "n_name": "VIETNAM", "n_regionkey": 2, "n_comment": ""},
      {"_id": 22, "n_nationkey": 22, "n_name": "RUSSIA", "n_regionkey": 3, "n_comment": ""},
      {"_id": 23, "n_nationkey": 23, "n_name": "UNITED KINGDOM", "n_regionkey": 3, "n_comment": ""},
      {"_id": 24, "n_nationkey": 24, "n_name": "UNITED STATES", "n_regionkey": 1, "n_comment": ""}
    ]}`

  populate_supplier(type: exec_batch, count: suppliers, size: batch_size) `{"insert": "supplier", "documents": [{"_id": $1, "s_suppkey": $1, "s_name": "$2", "s_address": "$3", "s_nationkey": $4, "s_phone": "$5", "s_acctbal": $6, "s_comment": "$7"}]}` (
    iter(),
    regex('[a-zA-Z]{15,25}'),
    regex('[a-zA-Z]{15,40}'),
    gen('number:0,24'),
    regex('[a-zA-Z]{15,15}'),
    uniform.float(-1000.00, 9000.00, 2),
    regex('[a-zA-Z]{10,30}')
  )

  populate_part(type: exec_batch, count: parts, size: batch_size) `{"insert": "part", "documents": [{"_id": $1, "p_partkey": $1, "p_name": "$2", "p_mfgr": "$3", "p_brand": "$4", "p_type": "$5", "p_size": $6, "p_container": "$7", "p_retailprice": $8, "p_comment": "$9"}]}` (
    iter(),
    regex('[a-zA-Z]{20,55}'),
    regex('[a-zA-Z]{10,25}'),
    regex('[a-zA-Z]{5,10}'),
    regex('[a-zA-Z]{10,25}'),
    gen('number:1,50'),
    regex('[a-zA-Z]{5,10}'),
    uniform.float(900.00, 2000.00, 2),
    regex('[a-zA-Z]{5,23}')
  )

  populate_partsupp(type: exec_batch, count: parts, size: batch_size) `{"insert": "partsupp", "documents": [{"ps_partkey": $1, "ps_suppkey": $2, "ps_availqty": $3, "ps_supplycost": $4, "ps_comment": "$5"}]}` (
    iter(),
    gen('number:1,1000'),
    gen('number:1,9999'),
    uniform.float(1.00, 1000.00, 2),
    regex('[a-zA-Z]{10,40}')
  )

  populate_customer(type: exec_batch, count: customers, size: batch_size) `{"insert": "customer", "documents": [{"_id": $1, "c_custkey": $1, "c_name": "$2", "c_address": "$3", "c_nationkey": $4, "c_phone": "$5", "c_acctbal": $6, "c_mktsegment": "$7", "c_comment": "$8"}]}` (
    iter(),
    regex('[a-zA-Z]{10,25}'),
    regex('[a-zA-Z]{15,40}'),
    gen('number:0,24'),
    regex('[a-zA-Z]{15,15}'),
    uniform.float(-1000.00, 9000.00, 2),
    uniform.set(['AUTOMOBILE', 'BUILDING', 'FURNITURE', 'MACHINERY', 'HOUSEHOLD'],[]),
    regex('[a-zA-Z]{10,40}')
  )

  populate_orders(type: exec_batch, count: orders, size: batch_size) `{"insert": "orders", "documents": [{"_id": $1, "o_orderkey": $1, "o_custkey": $2, "o_orderstatus": "$3", "o_totalprice": $4, "o_orderdate": "$5", "o_orderpriority": "$6", "o_clerk": "$7", "o_shippriority": 0, "o_comment": "$8"}]}` (
    iter(),
    gen('number:1,15000'),
    uniform.set(['O', 'F', 'P'],[]),
    uniform.float(1000.00, 401000.00, 2),
    gen('date:1992-01-01,1998-12-31'),
    uniform.set(['1-URGENT', '2-HIGH', '3-MEDIUM', '4-NOT SPECIFIED', '5-LOW'],[]),
    regex('[a-zA-Z]{10,15}'),
    regex('[a-zA-Z]{10,30}')
  )

  populate_lineitem(type: exec_batch, count: orders, size: batch_size) `{"insert": "lineitem", "documents": [{"l_orderkey": $1, "l_partkey": $2, "l_suppkey": $3, "l_linenumber": $4, "l_quantity": $5, "l_extendedprice": $6, "l_discount": $7, "l_tax": $8, "l_returnflag": "$9", "l_linestatus": "$10", "l_shipdate": "$11", "l_commitdate": "$12", "l_receiptdate": "$13", "l_shipinstruct": "$14", "l_shipmode": "$15", "l_comment": "$16"}]}` (
    iter(),
    gen('number:1,20000'),
    gen('number:1,1000'),
    gen('number:1,4'),
    uniform.float(1.00, 50.00, 2),
    uniform.float(100.00, 50000.00, 2),
    uniform.float(0.00, 0.10, 2),
    uniform.float(0.00, 0.08, 2),
    uniform.set(['R', 'A', 'N'],[]),
    uniform.set(['O', 'F'],[]),
    gen('date:1992-01-01,1998-12-31'),
    gen('date:1992-01-01,1998-12-31'),
    gen('date:1992-01-01,1998-12-31'),
    uniform.set(['DELIVER IN PERSON', 'COLLECT COD', 'NONE', 'TAKE BACK RETURN'],[]),
    uniform.set(['REG AIR', 'AIR', 'RAIL', 'SHIP', 'TRUCK', 'MAIL', 'FOB'],[]),
    regex('[a-zA-Z]{10,20}')
  )
}

deseed {
  delete_lineitem(type: exec) `{"delete": "lineitem", "deletes": [{"q": {}, "limit": 0}]}`

  delete_orders(type: exec) `{"delete": "orders", "deletes": [{"q": {}, "limit": 0}]}`

  delete_partsupp(type: exec) `{"delete": "partsupp", "deletes": [{"q": {}, "limit": 0}]}`

  delete_customer(type: exec) `{"delete": "customer", "deletes": [{"q": {}, "limit": 0}]}`

  delete_part(type: exec) `{"delete": "part", "deletes": [{"q": {}, "limit": 0}]}`

  delete_supplier(type: exec) `{"delete": "supplier", "deletes": [{"q": {}, "limit": 0}]}`

  delete_nation(type: exec) `{"delete": "nation", "deletes": [{"q": {}, "limit": 0}]}`

  delete_region(type: exec) `{"delete": "region", "deletes": [{"q": {}, "limit": 0}]}`
}

down {
  drop_lineitem(type: exec) `{"drop": "lineitem"}`

  drop_orders(type: exec) `{"drop": "orders"}`

  drop_partsupp(type: exec) `{"drop": "partsupp"}`

  drop_customer(type: exec) `{"drop": "customer"}`

  drop_part(type: exec) `{"drop": "part"}`

  drop_supplier(type: exec) `{"drop": "supplier"}`

  drop_nation(type: exec) `{"drop": "nation"}`

  drop_region(type: exec) `{"drop": "region"}`
}

weights {
  q14_promotion_effect   = 25
  q1_pricing_summary     = 25
  q3_shipping_priority   = 25
  q6_forecasting_revenue = 25
}

run {
  q1_pricing_summary(type: query) `{"aggregate": "lineitem", "pipeline": [{"$match": {"l_shipdate": {"$lte": "1998-09-01"}}}, {"$group": {"_id": {"l_returnflag": "$l_returnflag", "l_linestatus": "$l_linestatus"}, "sum_qty": {"$sum": "$l_quantity"}, "sum_base_price": {"$sum": "$l_extendedprice"}, "sum_disc_price": {"$sum": {"$multiply": ["$l_extendedprice", {"$subtract": [1, "$l_discount"]}]}}, "sum_charge": {"$sum": {"$multiply": ["$l_extendedprice", {"$subtract": [1, "$l_discount"]}, {"$add": [1, "$l_tax"]}]}}, "avg_qty": {"$avg": "$l_quantity"}, "avg_price": {"$avg": "$l_extendedprice"}, "avg_disc": {"$avg": "$l_discount"}, "count_order": {"$sum": 1}}}, {"$sort": {"_id.l_returnflag": 1, "_id.l_linestatus": 1}}], "cursor": {}}` (gen('number:60,120'))

  q3_shipping_priority(type: query) `{"aggregate": "customer", "pipeline": [{"$match": {"c_mktsegment": "$1"}}, {"$lookup": {"from": "orders", "localField": "c_custkey", "foreignField": "o_custkey", "as": "order_docs"}}, {"$unwind": "$order_docs"}, {"$match": {"order_docs.o_orderdate": {"$lt": "1995-03-15"}}}, {"$lookup": {"from": "lineitem", "localField": "order_docs.o_orderkey", "foreignField": "l_orderkey", "as": "line_docs"}}, {"$unwind": "$line_docs"}, {"$match": {"line_docs.l_shipdate": {"$gt": "1995-03-15"}}}, {"$group": {"_id": {"l_orderkey": "$line_docs.l_orderkey", "o_orderdate": "$order_docs.o_orderdate", "o_shippriority": "$order_docs.o_shippriority"}, "revenue": {"$sum": {"$multiply": ["$line_docs.l_extendedprice", {"$subtract": [1, "$line_docs.l_discount"]}]}}}}, {"$sort": {"revenue": -1, "_id.o_orderdate": 1}}, {"$limit": 10}], "cursor": {}}` (
    uniform.set(['AUTOMOBILE', 'BUILDING', 'FURNITURE', 'MACHINERY', 'HOUSEHOLD'],[]),
    gen('number:1,31')
  )

  q6_forecasting_revenue(type: query) `{"aggregate": "lineitem", "pipeline": [{"$match": {"l_shipdate": {"$gte": "$1-01-01", "$lt": "$1-12-31"}, "l_discount": {"$gte": $2, "$lte": $2}, "l_quantity": {"$lt": $3}}}, {"$group": {"_id": null, "revenue": {"$sum": {"$multiply": ["$l_extendedprice", "$l_discount"]}}}}], "cursor": {}}` (
    gen('number:1993,1997'),
    uniform.float(0.02, 0.09, 2),
    gen('number:24,25')
  )

  q14_promotion_effect(type: query) `{"aggregate": "lineitem", "pipeline": [{"$match": {"l_shipdate": {"$gte": "$1-01-01", "$lte": "$1-12-31"}}}, {"$lookup": {"from": "part", "localField": "l_partkey", "foreignField": "p_partkey", "as": "part_doc"}}, {"$unwind": "$part_doc"}, {"$group": {"_id": null, "promo_revenue": {"$sum": {"$cond": [{"$regexMatch": {"input": "$part_doc.p_type", "regex": "^PROMO"}}, {"$multiply": ["$l_extendedprice", {"$subtract": [1, "$l_discount"]}]}, 0]}}, "total_revenue": {"$sum": {"$multiply": ["$l_extendedprice", {"$subtract": [1, "$l_discount"]}]}}}}, {"$project": {"promo_revenue": {"$multiply": [100, {"$divide": ["$promo_revenue", "$total_revenue"]}]}}}], "cursor": {}}` (
    gen('number:1993,1997'),
    gen('number:1,12')
  )
}
