let scale_factor = int(coalesce(env_nil('SCALE_FACTOR'), 1))
let regions      = int(coalesce(env_nil('REGIONS'), 5))
let nations      = int(coalesce(env_nil('NATIONS'), 25))
let suppliers    = int(coalesce(env_nil('SUPPLIERS'), 100))
let parts        = int(coalesce(env_nil('PARTS'), 200))
let customers    = int(coalesce(env_nil('CUSTOMERS'), 150))
let orders       = int(coalesce(env_nil('ORDERS'), 1000))
let batch_size   = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_region `IF OBJECT_ID('region', 'U') IS NULL
    CREATE TABLE region (
      r_regionkey INT NOT NULL PRIMARY KEY,
      r_name VARCHAR(25) NOT NULL,
      r_comment VARCHAR(152)
    )`

  create_nation `IF OBJECT_ID('nation', 'U') IS NULL
    CREATE TABLE nation (
      n_nationkey INT NOT NULL PRIMARY KEY,
      n_name VARCHAR(25) NOT NULL,
      n_regionkey INT NOT NULL,
      n_comment VARCHAR(152)
    )`

  create_supplier `IF OBJECT_ID('supplier', 'U') IS NULL
    CREATE TABLE supplier (
      s_suppkey INT NOT NULL PRIMARY KEY,
      s_name VARCHAR(25) NOT NULL,
      s_address VARCHAR(40) NOT NULL,
      s_nationkey INT NOT NULL,
      s_phone VARCHAR(15) NOT NULL,
      s_acctbal DECIMAL(15,2) NOT NULL,
      s_comment VARCHAR(101)
    )`

  create_part `IF OBJECT_ID('part', 'U') IS NULL
    CREATE TABLE part (
      p_partkey INT NOT NULL PRIMARY KEY,
      p_name VARCHAR(55) NOT NULL,
      p_mfgr VARCHAR(25) NOT NULL,
      p_brand VARCHAR(10) NOT NULL,
      p_type VARCHAR(25) NOT NULL,
      p_size INT NOT NULL,
      p_container VARCHAR(10) NOT NULL,
      p_retailprice DECIMAL(15,2) NOT NULL,
      p_comment VARCHAR(23)
    )`

  create_partsupp `IF OBJECT_ID('partsupp', 'U') IS NULL
    CREATE TABLE partsupp (
      ps_partkey INT NOT NULL,
      ps_suppkey INT NOT NULL,
      ps_availqty INT NOT NULL,
      ps_supplycost DECIMAL(15,2) NOT NULL,
      ps_comment VARCHAR(199),
      PRIMARY KEY (ps_partkey, ps_suppkey)
    )`

  create_customer `IF OBJECT_ID('customer', 'U') IS NULL
    CREATE TABLE customer (
      c_custkey INT NOT NULL PRIMARY KEY,
      c_name VARCHAR(25) NOT NULL,
      c_address VARCHAR(40) NOT NULL,
      c_nationkey INT NOT NULL,
      c_phone VARCHAR(15) NOT NULL,
      c_acctbal DECIMAL(15,2) NOT NULL,
      c_mktsegment VARCHAR(10) NOT NULL,
      c_comment VARCHAR(117)
    )`

  create_orders `IF OBJECT_ID('orders', 'U') IS NULL
    CREATE TABLE orders (
      o_orderkey INT NOT NULL PRIMARY KEY,
      o_custkey INT NOT NULL,
      o_orderstatus CHAR(1) NOT NULL,
      o_totalprice DECIMAL(15,2) NOT NULL,
      o_orderdate DATE NOT NULL,
      o_orderpriority VARCHAR(15) NOT NULL,
      o_clerk VARCHAR(15) NOT NULL,
      o_shippriority INT NOT NULL,
      o_comment VARCHAR(79)
    )`

  create_lineitem `IF OBJECT_ID('lineitem', 'U') IS NULL
    CREATE TABLE lineitem (
      l_orderkey INT NOT NULL,
      l_partkey INT NOT NULL,
      l_suppkey INT NOT NULL,
      l_linenumber INT NOT NULL,
      l_quantity DECIMAL(15,2) NOT NULL,
      l_extendedprice DECIMAL(15,2) NOT NULL,
      l_discount DECIMAL(15,2) NOT NULL,
      l_tax DECIMAL(15,2) NOT NULL,
      l_returnflag CHAR(1) NOT NULL,
      l_linestatus CHAR(1) NOT NULL,
      l_shipdate DATE NOT NULL,
      l_commitdate DATE NOT NULL,
      l_receiptdate DATE NOT NULL,
      l_shipinstruct VARCHAR(25) NOT NULL,
      l_shipmode VARCHAR(10) NOT NULL,
      l_comment VARCHAR(44),
      PRIMARY KEY (l_orderkey, l_linenumber)
    )`
}

seed {
  populate_region `INSERT INTO region (r_regionkey, r_name, r_comment) VALUES
      (0,'AFRICA',''), (1,'AMERICA',''), (2,'ASIA',''),
      (3,'EUROPE',''), (4,'MIDDLE EAST','')`

  populate_nation `INSERT INTO nation (n_nationkey, n_name, n_regionkey, n_comment) VALUES
      (0,'ALGERIA',0,''),    (1,'ARGENTINA',1,''),  (2,'BRAZIL',1,''),
      (3,'CANADA',1,''),     (4,'EGYPT',4,''),      (5,'ETHIOPIA',0,''),
      (6,'FRANCE',3,''),     (7,'GERMANY',3,''),    (8,'INDIA',2,''),
      (9,'INDONESIA',2,''),  (10,'IRAN',4,''),      (11,'IRAQ',4,''),
      (12,'JAPAN',2,''),     (13,'JORDAN',4,''),    (14,'KENYA',0,''),
      (15,'MOROCCO',0,''),   (16,'MOZAMBIQUE',0,''), (17,'PERU',1,''),
      (18,'CHINA',2,''),     (19,'ROMANIA',3,''),   (20,'SAUDI ARABIA',4,''),
      (21,'VIETNAM',2,''),   (22,'RUSSIA',3,''),    (23,'UNITED KINGDOM',3,''),
      (24,'UNITED STATES',1,'')`

  populate_supplier `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $1
    )
    INSERT INTO supplier (s_suppkey, s_name, s_address, s_nationkey,
      s_phone, s_acctbal, s_comment)
    SELECT s,
      CONCAT('Supplier#', RIGHT(REPLICATE('0', 9) + CAST(s AS VARCHAR), 9)),
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 25),
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 25) AS INT),
      CONCAT(RIGHT('00' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 90) AS INT) + 10 AS VARCHAR), 2), '-',
        RIGHT('000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 1000) AS INT) AS VARCHAR), 3), '-',
        RIGHT('000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 1000) AS INT) AS VARCHAR), 3), '-',
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS VARCHAR), 4)),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 10000 - 1000, 2) AS DECIMAL(15,2)),
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 30)
    FROM seq
    OPTION (MAXRECURSION 10000)` (suppliers)

  populate_part `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    INSERT INTO part (p_partkey, p_name, p_mfgr, p_brand, p_type,
      p_size, p_container, p_retailprice, p_comment)
    SELECT $1 * $2 + s,
      LEFT(CONCAT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''),
        REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', '')), 40),
      CONCAT('Manufacturer#', CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 5) AS INT) + 1),
      CONCAT('Brand#', CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 5) AS INT) + 1, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 5) AS INT) + 1),
      'STANDARD',
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 50) AS INT) + 1,
      'SM CASE',
      CAST(ROUND((90000 + ($1 * $2 + s) / 10.0 + RAND(CHECKSUM(NEWID())) * 100) / 100, 2) AS DECIMAL(15,2)),
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 15)
    FROM seq
    OPTION (MAXRECURSION 10000)` (
    batch(parts / batch_size),
    batch_size
  )

  populate_customer `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    INSERT INTO customer (c_custkey, c_name, c_address, c_nationkey,
      c_phone, c_acctbal, c_mktsegment, c_comment)
    SELECT $1 * $2 + s,
      CONCAT('Customer#', RIGHT(REPLICATE('0', 9) + CAST($1 * $2 + s AS VARCHAR), 9)),
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 25),
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 25) AS INT),
      CONCAT(RIGHT('00' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 90) AS INT) + 10 AS VARCHAR), 2), '-',
        RIGHT('000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 1000) AS INT) AS VARCHAR), 3), '-',
        RIGHT('000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 1000) AS INT) AS VARCHAR), 3), '-',
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS VARCHAR), 4)),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 10000 - 1000, 2) AS DECIMAL(15,2)),
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 5) AS INT) % 5
        WHEN 0 THEN 'AUTOMOBILE' WHEN 1 THEN 'BUILDING'
        WHEN 2 THEN 'FURNITURE' WHEN 3 THEN 'MACHINERY'
        ELSE 'HOUSEHOLD' END,
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 40)
    FROM seq
    OPTION (MAXRECURSION 10000)` (
    batch(customers / batch_size),
    batch_size
  )

  populate_orders `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    INSERT INTO orders (o_orderkey, o_custkey, o_orderstatus,
      o_totalprice, o_orderdate, o_orderpriority, o_clerk,
      o_shippriority, o_comment)
    SELECT $1 * $2 + s,
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * $3) AS INT) + 1,
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 3) AS INT) % 3
        WHEN 0 THEN 'O' WHEN 1 THEN 'F' ELSE 'P' END,
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 400000 + 1000, 2) AS DECIMAL(15,2)),
      DATEADD(DAY, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 2557) AS INT), '1992-01-01'),
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 5) AS INT) % 5
        WHEN 0 THEN '1-URGENT' WHEN 1 THEN '2-HIGH' WHEN 2 THEN '3-MEDIUM'
        WHEN 3 THEN '4-NOT SPECIFIED' ELSE '5-LOW' END,
      CONCAT('Clerk#', RIGHT(REPLICATE('0', 9) + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 1000) AS INT) + 1 AS VARCHAR), 9)),
      0,
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 30)
    FROM seq
    OPTION (MAXRECURSION 10000)` (
    batch(orders / batch_size),
    batch_size,
    customers
  )

  populate_lineitem `INSERT INTO lineitem (l_orderkey, l_partkey, l_suppkey, l_linenumber,
      l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag,
      l_linestatus, l_shipdate, l_commitdate, l_receiptdate,
      l_shipinstruct, l_shipmode, l_comment)
    SELECT o.o_orderkey,
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * $3) AS INT) + 1,
      CAST(FLOOR(RAND(CHECKSUM(NEWID())) * $4) AS INT) + 1,
      1,
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 50 + 1, 2) AS DECIMAL(15,2)),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 90000 + 1000, 2) AS DECIMAL(15,2)),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 0.10, 2) AS DECIMAL(15,2)),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 0.08, 2) AS DECIMAL(15,2)),
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 3) AS INT) % 3
        WHEN 0 THEN 'R' WHEN 1 THEN 'A' ELSE 'N' END,
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 2) AS INT) % 2
        WHEN 0 THEN 'O' ELSE 'F' END,
      DATEADD(DAY, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 120) AS INT) + 1, o.o_orderdate),
      DATEADD(DAY, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 90) AS INT) + 1, o.o_orderdate),
      DATEADD(DAY, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 150) AS INT) + 1, o.o_orderdate),
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 4) AS INT) % 4
        WHEN 0 THEN 'DELIVER IN PERSON' WHEN 1 THEN 'COLLECT COD'
        WHEN 2 THEN 'NONE' ELSE 'TAKE BACK RETURN' END,
      CASE CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 7) AS INT) % 7
        WHEN 0 THEN 'REG AIR' WHEN 1 THEN 'AIR' WHEN 2 THEN 'RAIL'
        WHEN 3 THEN 'SHIP' WHEN 4 THEN 'TRUCK' WHEN 5 THEN 'MAIL'
        ELSE 'FOB' END,
      LEFT(REPLACE(CONVERT(VARCHAR(36), NEWID()), '-', ''), 20)
    FROM orders o
    WHERE o.o_orderkey > $1 * $2
      AND o.o_orderkey <= ($1 + 1) * $2` (
    batch(orders / batch_size),
    batch_size,
    parts,
    suppliers
  )
}

weights {
  q14_promotion_effect   = 25
  q1_pricing_summary     = 25
  q3_shipping_priority   = 25
  q6_forecasting_revenue = 25
}

run {
  q1_pricing_summary(type: query) `SELECT l_returnflag, l_linestatus,
      SUM(l_quantity) AS sum_qty,
      SUM(l_extendedprice) AS sum_base_price,
      SUM(l_extendedprice * (1 - l_discount)) AS sum_disc_price,
      SUM(l_extendedprice * (1 - l_discount) * (1 + l_tax)) AS sum_charge,
      AVG(l_quantity) AS avg_qty,
      AVG(l_extendedprice) AS avg_price,
      AVG(l_discount) AS avg_disc,
      COUNT(*) AS count_order
    FROM lineitem
    WHERE l_shipdate <= DATEADD(DAY, -CAST(@p1 AS INT), '1998-12-01')
    GROUP BY l_returnflag, l_linestatus
    ORDER BY l_returnflag, l_linestatus` (gen('number:60,120'))

  q3_shipping_priority(type: query) `SELECT TOP 10
      l.l_orderkey,
      SUM(l.l_extendedprice * (1 - l.l_discount)) AS revenue,
      o.o_orderdate, o.o_shippriority
    FROM customer c
    JOIN orders o ON c.c_custkey = o.o_custkey
    JOIN lineitem l ON l.l_orderkey = o.o_orderkey
    WHERE c.c_mktsegment = @p1
      AND o.o_orderdate < DATEADD(DAY, CAST(@p2 AS INT), '1995-03-01')
      AND l.l_shipdate > DATEADD(DAY, CAST(@p2 AS INT), '1995-03-01')
    GROUP BY l.l_orderkey, o.o_orderdate, o.o_shippriority
    ORDER BY revenue DESC, o.o_orderdate` (
    uniform.set(['AUTOMOBILE', 'BUILDING', 'FURNITURE', 'MACHINERY', 'HOUSEHOLD'],[]),
    gen('number:1,31')
  )

  q6_forecasting_revenue(type: query) `SELECT SUM(l_extendedprice * l_discount) AS revenue
    FROM lineitem
    WHERE l_shipdate >= CAST(CONCAT(@p1, '-01-01') AS DATE)
      AND l_shipdate < DATEADD(YEAR, 1, CAST(CONCAT(@p1, '-01-01') AS DATE))
      AND l_discount BETWEEN CAST(@p2 AS DECIMAL(15,2)) - 0.01
        AND CAST(@p2 AS DECIMAL(15,2)) + 0.01
      AND l_quantity < CAST(@p3 AS DECIMAL(15,2))` (
    gen('number:1993,1997'),
    uniform.float(0.02, 0.09, 2),
    gen('number:24,25')
  )

  q14_promotion_effect(type: query) `SELECT
      100.00 * SUM(CASE WHEN p.p_type LIKE 'PROMO%'
        THEN l.l_extendedprice * (1 - l.l_discount) ELSE 0 END)
      / SUM(l.l_extendedprice * (1 - l.l_discount)) AS promo_revenue
    FROM lineitem l
    JOIN part p ON l.l_partkey = p.p_partkey
    WHERE l_shipdate >= CAST(CONCAT(@p1, '-', RIGHT('0' + @p2, 2), '-01') AS DATE)
      AND l_shipdate < DATEADD(MONTH, 1,
        CAST(CONCAT(@p1, '-', RIGHT('0' + @p2, 2), '-01') AS DATE))` (
    gen('number:1993,1997'),
    gen('number:1,12')
  )
}

deseed {
  delete_lineitem(type: exec) `DELETE FROM lineitem`

  delete_orders(type: exec) `DELETE FROM orders`

  delete_partsupp(type: exec) `DELETE FROM partsupp`

  delete_customer(type: exec) `DELETE FROM customer`

  delete_part(type: exec) `DELETE FROM part`

  delete_supplier(type: exec) `DELETE FROM supplier`

  delete_nation(type: exec) `DELETE FROM nation`

  delete_region(type: exec) `DELETE FROM region`
}

down {
  drop_lineitem(type: exec) `DROP TABLE IF EXISTS lineitem`

  drop_orders(type: exec) `DROP TABLE IF EXISTS orders`

  drop_partsupp(type: exec) `DROP TABLE IF EXISTS partsupp`

  drop_customer(type: exec) `DROP TABLE IF EXISTS customer`

  drop_part(type: exec) `DROP TABLE IF EXISTS part`

  drop_supplier(type: exec) `DROP TABLE IF EXISTS supplier`

  drop_nation(type: exec) `DROP TABLE IF EXISTS nation`

  drop_region(type: exec) `DROP TABLE IF EXISTS region`
}

expect {
  error_rate < 1
}
