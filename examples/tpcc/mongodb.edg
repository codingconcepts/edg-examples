let warehouses = int(coalesce(env_nil('WAREHOUSES'), 1))
let districts  = int(coalesce(env_nil('DISTRICTS'), 10))
let customers  = int(coalesce(env_nil('CUSTOMERS'), 300))
let orders     = int(coalesce(env_nil('ORDERS'), 300))
let stock      = int(coalesce(env_nil('STOCK'), 1000))
let items      = int(coalesce(env_nil('ITEMS'), 1000))
let batch_size = int(coalesce(env_nil('BATCH_SIZE'), 100))
let ol_batch   = int(coalesce(env_nil('OL_BATCH'), 100))

up {
  create_warehouse(type: exec) `{"create": "warehouse"}`

  create_district(type: exec) `{"create": "district"}`

  create_customer(type: exec) `{"create": "customer"}`

  create_history(type: exec) `{"create": "history"}`

  create_oorder(type: exec) `{"create": "oorder"}`

  create_new_order(type: exec) `{"create": "new_order"}`

  create_order_line(type: exec) `{"create": "order_line"}`

  create_item(type: exec) `{"create": "item"}`

  create_stock(type: exec) `{"create": "stock"}`

  create_idx_customer_name(type: exec) `{"createIndexes": "customer", "indexes": [{"key": {"c_w_id": 1, "c_d_id": 1, "c_last": 1, "c_first": 1}, "name": "idx_customer_name"}]}`

  create_idx_oorder_customer(type: exec) `{"createIndexes": "oorder", "indexes": [{"key": {"o_w_id": 1, "o_d_id": 1, "o_c_id": 1, "o_id": -1}, "name": "idx_oorder_customer"}]}`

  create_idx_district_pk(type: exec) `{"createIndexes": "district", "indexes": [{"key": {"d_w_id": 1, "d_id": 1}, "name": "idx_district_pk", "unique": true}]}`

  create_idx_new_order_pk(type: exec) `{"createIndexes": "new_order", "indexes": [{"key": {"no_w_id": 1, "no_d_id": 1, "no_o_id": 1}, "name": "idx_new_order_pk", "unique": true}]}`

  create_idx_stock_pk(type: exec) `{"createIndexes": "stock", "indexes": [{"key": {"s_w_id": 1, "s_i_id": 1}, "name": "idx_stock_pk", "unique": true}]}`
}

seed {
  populate_item(type: exec_batch, count: items, size: batch_size) `{"insert": "item", "documents": [{"_id": $1, "i_id": $1, "i_im_id": $2, "i_name": "$3", "i_price": $4, "i_data": "$5"}]}` (
    iter(),
    gen('number:1,10000'),
    regex('[a-zA-Z]{6,24}'),
    uniform.float(1.00, 100.00, 2),
    regex('[a-zA-Z]{26,50}')
  )

  populate_warehouse(type: exec_batch, count: warehouses, size: batch_size) `{"insert": "warehouse", "documents": [{"_id": $1, "w_id": $1, "w_name": "$2", "w_street_1": "$3", "w_street_2": "$4", "w_city": "$5", "w_state": "$6", "w_zip": "$7", "w_tax": $8, "w_ytd": 300000}]}` (
    iter(),
    regex('[a-zA-Z]{6,10}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{2,2}'),
    regex('[a-zA-Z]{9,9}'),
    uniform.float(0.0000, 0.2000, 4)
  )

  fetch_warehouses `{"find": "warehouse", "filter": {}, "projection": {"w_id": 1}}`

  populate_district(type: exec_batch, count: districts, size: batch_size) `{"insert": "district", "documents": [{"d_w_id": $1, "d_id": $2, "d_name": "$3", "d_street_1": "$4", "d_street_2": "$5", "d_city": "$6", "d_state": "$7", "d_zip": "$8", "d_tax": $9, "d_ytd": 30000, "d_next_o_id": 3001}]}` (
    uniform.ref('fetch_warehouses').w_id,
    iter(),
    regex('[a-zA-Z]{6,10}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{2,2}'),
    regex('[a-zA-Z]{9,9}'),
    uniform.float(0.0000, 0.2000, 4)
  )

  populate_customer(type: exec_batch, count: customers, size: batch_size) `{"insert": "customer", "documents": [{"c_w_id": $1, "c_d_id": $2, "c_id": $3, "c_first": "$4", "c_middle": "OE", "c_last": "$5", "c_street_1": "$6", "c_street_2": "$7", "c_city": "$8", "c_state": "$9", "c_zip": "$10", "c_phone": "$11", "c_since": {"$date": "2024-01-01T00:00:00Z"}, "c_credit": "GC", "c_credit_lim": 50000, "c_discount": $12, "c_balance": -10, "c_ytd_payment": 10, "c_payment_cnt": 1, "c_delivery_cnt": 0, "c_data": "$13"}]}` (
    uniform.ref('fetch_warehouses').w_id,
    gen('number:1,10'),
    iter(),
    regex('[a-zA-Z]{6,16}'),
    regex('[a-zA-Z]{6,16}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{10,20}'),
    regex('[a-zA-Z]{2,2}'),
    regex('[a-zA-Z]{9,9}'),
    regex('[a-zA-Z]{16,16}'),
    uniform.float(0.0000, 0.5000, 4),
    regex('[a-zA-Z]{300,500}')
  )

  populate_history(type: exec_batch, count: customers, size: batch_size) `{"insert": "history", "documents": [{"_id": {"$oid": "$1"}, "h_c_id": $2, "h_c_d_id": $3, "h_c_w_id": $4, "h_d_id": $3, "h_w_id": $4, "h_date": {"$date": "2024-01-01T00:00:00Z"}, "h_amount": 10, "h_data": "$5"}]}` (
    objectid(),
    iter(),
    gen('number:1,10'),
    uniform.ref('fetch_warehouses').w_id,
    regex('[a-zA-Z]{12,24}')
  )

  populate_oorder(type: exec_batch, count: orders, size: batch_size) `{"insert": "oorder", "documents": [{"o_w_id": $1, "o_d_id": $2, "o_id": $3, "o_c_id": $4, "o_entry_d": {"$date": "2024-01-01T00:00:00Z"}, "o_carrier_id": 1, "o_ol_cnt": $5, "o_all_local": 1}]}` (
    uniform.ref('fetch_warehouses').w_id,
    gen('number:1,10'),
    iter(),
    gen('number:1,3000'),
    gen('number:5,15')
  )

  populate_new_order(type: exec_batch, count: districts, size: batch_size) `{"insert": "new_order", "documents": [{"no_w_id": $1, "no_d_id": $2, "no_o_id": $3}]}` (
    uniform.ref('fetch_warehouses').w_id,
    gen('number:1,10'),
    iter()
  )

  populate_order_line(type: exec_batch, count: orders, size: batch_size) `{"insert": "order_line", "documents": [{"ol_w_id": $1, "ol_d_id": $2, "ol_o_id": $3, "ol_number": $4, "ol_i_id": $5, "ol_supply_w_id": $1, "ol_delivery_d": {"$date": "2024-01-01T00:00:00Z"}, "ol_quantity": 5, "ol_amount": $6, "ol_dist_info": "$7"}]}` (
    uniform.ref('fetch_warehouses').w_id,
    gen('number:1,10'),
    gen('number:1,3000'),
    gen('number:1,15'),
    gen('number:1,100000'),
    uniform.float(0.00, 9999.99, 2),
    regex('[a-zA-Z]{24,24}')
  )

  populate_stock(type: exec_batch, count: stock, size: batch_size) `{"insert": "stock", "documents": [{"s_w_id": $1, "s_i_id": $2, "s_quantity": $3, "s_dist_01": "$4", "s_dist_02": "$5", "s_dist_03": "$6", "s_dist_04": "$7", "s_dist_05": "$8", "s_dist_06": "$9", "s_dist_07": "$10", "s_dist_08": "$11", "s_dist_09": "$12", "s_dist_10": "$13", "s_ytd": 0, "s_order_cnt": 0, "s_remote_cnt": 0, "s_data": "$14"}]}` (
    uniform.ref('fetch_warehouses').w_id,
    iter(),
    gen('number:10,100'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{24,24}'),
    regex('[a-zA-Z]{26,50}')
  )
}

weights {
  delivery     = 4
  new_order    = 45
  order_status = 4
  payment      = 43
  stock_level  = 4
}

init {
  fetch_warehouses(type: query) `{"find": "warehouse", "filter": {}, "projection": {"w_id": 1}}`
}

run {
  transaction new_order(wait: 180ms) {
    let ol_cnt = gen('number:5,15')
    let order_id = gen('number:3001,999999')
    read_district(type: query) `{"find": "district", "filter": {"d_w_id": $1, "d_id": $2}, "limit": 1}` (
      ref_perm('fetch_warehouses').w_id,
      gen('number:1,10')
    )
    insert_oorder(type: exec) `{"insert": "oorder", "documents": [{"o_w_id": $1, "o_d_id": $2, "o_id": $3, "o_c_id": $4, "o_entry_d": {"$date": "2024-01-01T00:00:00Z"}, "o_carrier_id": null, "o_ol_cnt": $5, "o_all_local": 1}]}` (
      ref_same('read_district').d_w_id,
      ref_same('read_district').d_id,
      local('order_id'),
      nurand(1023, 1, customers / districts),
      local('ol_cnt')
    )
    insert_new_order(type: exec) `{"insert": "new_order", "documents": [{"no_w_id": $1, "no_d_id": $2, "no_o_id": $3}]}` (
      ref_same('read_district').d_w_id,
      ref_same('read_district').d_id,
      local('order_id')
    )
  }

  transaction payment(wait: 30ms) {
    let amount = gen('number:100,500000')
    let w_id = ref_perm('fetch_warehouses').w_id
    update_warehouse(type: exec) `{"update": "warehouse", "updates": [{"q": {"w_id": $1}, "u": {"$inc": {"w_ytd": $2}}}]}` (
      local('w_id'),
      local('amount')
    )
    read_customer(type: query) `{"find": "customer", "filter": {"c_w_id": $1, "c_d_id": $2, "c_id": $3}, "limit": 1}` (
      local('w_id'),
      gen('number:1,10'),
      nurand(1023, 1, customers / districts)
    )
    update_customer(type: exec) `{"update": "customer", "updates": [{"q": {"c_w_id": $1, "c_d_id": $2, "c_id": $3}, "u": {"$inc": {"c_balance": $4, "c_ytd_payment": $4, "c_payment_cnt": 1}}}]}` (
      ref_same('read_customer').c_w_id,
      ref_same('read_customer').c_d_id,
      ref_same('read_customer').c_id,
      local('amount')
    )
    insert_history(type: exec) `{"insert": "history", "documents": [{"_id": {"$oid": "$1"}, "h_c_id": $2, "h_c_d_id": $3, "h_c_w_id": $4, "h_d_id": $3, "h_w_id": $4, "h_date": {"$date": "2024-01-01T00:00:00Z"}, "h_amount": $5, "h_data": "payment"}]}` (
      objectid(),
      ref_same('read_customer').c_id,
      ref_same('read_customer').c_d_id,
      ref_same('read_customer').c_w_id,
      local('amount')
    )
  }

  order_status(type: query, wait: 20ms) `{"find": "oorder", "filter": {"o_w_id": $1, "o_d_id": $2, "o_c_id": $3}, "sort": {"o_id": -1}, "limit": 1}` (
    ref_perm('fetch_warehouses').w_id,
    gen('number:1,10'),
    nurand(1023, 1, customers / districts)
  )

  delivery(type: exec, wait: 20ms) `{"findAndModify": "new_order", "query": {"no_w_id": $1}, "sort": {"no_d_id": 1, "no_o_id": 1}, "remove": true}` (
    ref_perm('fetch_warehouses').w_id,
    gen('number:1,10')
  )

  stock_level(type: query, wait: 20ms) `{"aggregate": "stock", "pipeline": [{"$match": {"s_w_id": $1, "s_quantity": {"$lt": $3}}}, {"$count": "low_stock"}], "cursor": {}}` (
    ref_perm('fetch_warehouses').w_id,
    gen('number:1,10'),
    gen('number:10,20')
  )
}

deseed {
  delete_order_line(type: exec) `{"delete": "order_line", "deletes": [{"q": {}, "limit": 0}]}`

  delete_new_order(type: exec) `{"delete": "new_order", "deletes": [{"q": {}, "limit": 0}]}`

  delete_oorder(type: exec) `{"delete": "oorder", "deletes": [{"q": {}, "limit": 0}]}`

  delete_history(type: exec) `{"delete": "history", "deletes": [{"q": {}, "limit": 0}]}`

  delete_stock(type: exec) `{"delete": "stock", "deletes": [{"q": {}, "limit": 0}]}`

  delete_customer(type: exec) `{"delete": "customer", "deletes": [{"q": {}, "limit": 0}]}`

  delete_district(type: exec) `{"delete": "district", "deletes": [{"q": {}, "limit": 0}]}`

  delete_warehouse(type: exec) `{"delete": "warehouse", "deletes": [{"q": {}, "limit": 0}]}`

  delete_item(type: exec) `{"delete": "item", "deletes": [{"q": {}, "limit": 0}]}`
}

down {
  drop_order_line(type: exec) `{"drop": "order_line"}`

  drop_new_order(type: exec) `{"drop": "new_order"}`

  drop_oorder(type: exec) `{"drop": "oorder"}`

  drop_history(type: exec) `{"drop": "history"}`

  drop_stock(type: exec) `{"drop": "stock"}`

  drop_customer(type: exec) `{"drop": "customer"}`

  drop_district(type: exec) `{"drop": "district"}`

  drop_warehouse(type: exec) `{"drop": "warehouse"}`

  drop_item(type: exec) `{"drop": "item"}`
}

expect {
  error_rate < 1
}
