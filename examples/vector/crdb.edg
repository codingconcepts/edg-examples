let articles   = 1000
let batch_size = 100

up {
  create_article `CREATE TABLE IF NOT EXISTS article (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      title STRING NOT NULL,
      embedding_uniform VECTOR(32) NOT NULL,
      embedding_zipf VECTOR(32) NOT NULL,
      embedding_norm VECTOR(32) NOT NULL,
      embedding_exp VECTOR(32) NOT NULL,
      embedding_lognorm VECTOR(32) NOT NULL,
      created_at TIMESTAMP NOT NULL DEFAULT now()
    )`

  create_uniform_index `CREATE VECTOR INDEX IF NOT EXISTS idx_article_uniform
    ON article (embedding_uniform)`

  create_zipf_index `CREATE VECTOR INDEX IF NOT EXISTS idx_article_zipf
    ON article (embedding_zipf)`

  create_norm_index `CREATE VECTOR INDEX IF NOT EXISTS idx_article_norm
    ON article (embedding_norm)`

  create_exp_index `CREATE VECTOR INDEX IF NOT EXISTS idx_article_exp
    ON article (embedding_exp)`

  create_lognorm_index `CREATE VECTOR INDEX IF NOT EXISTS idx_article_lognorm
    ON article (embedding_lognorm)`
}

seed {
  populate_article(type: exec_batch, count: articles, size: batch_size) `INSERT INTO article (title, embedding_uniform, embedding_zipf, embedding_norm, embedding_exp, embedding_lognorm)
    SELECT t, u::VECTOR, z::VECTOR, n::VECTOR, e::VECTOR, l::VECTOR
    FROM unnest(
      ARRAY[$1],
      ARRAY[$2],
      ARRAY[$3],
      ARRAY[$4],
      ARRAY[$5],
      ARRAY[$6]
    ) AS t(t, u, z, n, e, l)` (
      gen('sentence:3'),
      vector(32, 5, 0.1),
      zipf.vector(32, 5, 0.1, 2.0, 1.0),
      norm.vector(32, 5, 0.1, 2.0, 0.8),
      exp.vector(32, 5, 0.1, 0.5),
      lognorm.vector(32, 5, 0.1, 1.0, 0.5)
  )
}

deseed {
  truncate_article(type: exec) `TRUNCATE TABLE article`
}

down {
  drop_article(type: exec) `DROP TABLE IF EXISTS article`
}

init {
  fetch_articles(type: query) `SELECT id FROM article`
}

run {
  insert_article(type: exec) `INSERT INTO article (title, embedding_uniform, embedding_zipf, embedding_norm, embedding_exp, embedding_lognorm)
    VALUES ($1, $2::VECTOR, $3::VECTOR, $4::VECTOR, $5::VECTOR, $6::VECTOR)` (
      gen('sentence:3'),
      vector(32, 5, 0.1),
      zipf.vector(32, 5, 0.1, 2.0, 1.0),
      norm.vector(32, 5, 0.1, 2.0, 0.8),
      exp.vector(32, 5, 0.1, 0.5),
      lognorm.vector(32, 5, 0.1, 1.0, 0.5)
  )

  find_similar_uniform(type: query) `SELECT id, title, embedding_uniform <=> $1::VECTOR AS distance
    FROM article
    ORDER BY embedding_uniform <=> $1::VECTOR
    LIMIT 10` (vector(32, 5, 0.1))

  find_similar_zipf(type: query) `SELECT id, title, embedding_zipf <=> $1::VECTOR AS distance
    FROM article
    ORDER BY embedding_zipf <=> $1::VECTOR
    LIMIT 10` (zipf.vector(32, 5, 0.1, 2.0, 1.0))

  find_similar_norm(type: query) `SELECT id, title, embedding_norm <=> $1::VECTOR AS distance
    FROM article
    ORDER BY embedding_norm <=> $1::VECTOR
    LIMIT 10` (norm.vector(32, 5, 0.1, 2.0, 0.8))

  find_similar_exp(type: query) `SELECT id, title, embedding_exp <=> $1::VECTOR AS distance
    FROM article
    ORDER BY embedding_exp <=> $1::VECTOR
    LIMIT 10` (exp.vector(32, 5, 0.1, 0.5))

  find_similar_lognorm(type: query) `SELECT id, title, embedding_lognorm <=> $1::VECTOR AS distance
    FROM article
    ORDER BY embedding_lognorm <=> $1::VECTOR
    LIMIT 10` (lognorm.vector(32, 5, 0.1, 1.0, 0.5))
}
