let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users `CREATE TABLE IF NOT EXISTS users (
      id TEXT NOT NULL DEFAULT (lower(hex(randomblob(16)))),
      city TEXT NOT NULL,
      name TEXT NOT NULL,
      address TEXT NOT NULL,
      credit_card TEXT NOT NULL,
      PRIMARY KEY (city, id)
    )`

  create_vehicles `CREATE TABLE IF NOT EXISTS vehicles (
      id TEXT NOT NULL DEFAULT (lower(hex(randomblob(16)))),
      city TEXT NOT NULL,
      owner_id TEXT NOT NULL,
      creation_time TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      status TEXT NOT NULL DEFAULT 'available',
      current_location TEXT NOT NULL,
      ext TEXT,
      PRIMARY KEY (city, id)
    )`

  create_rides `CREATE TABLE IF NOT EXISTS rides (
      id TEXT NOT NULL DEFAULT (lower(hex(randomblob(16)))),
      city TEXT NOT NULL,
      vehicle_city TEXT NOT NULL,
      rider_id TEXT NOT NULL,
      vehicle_id TEXT NOT NULL,
      start_address TEXT NOT NULL,
      end_address TEXT,
      start_time TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      end_time TIMESTAMP,
      revenue REAL,
      PRIMARY KEY (city, id)
    )`

  create_vehicle_location_histories `CREATE TABLE IF NOT EXISTS vehicle_location_histories (
      city TEXT NOT NULL,
      ride_id TEXT NOT NULL,
      timestamp TEXT NOT NULL DEFAULT (strftime('%Y-%m-%d %H:%M:%f', 'now')),
      lat REAL NOT NULL,
      lng REAL NOT NULL,
      PRIMARY KEY (city, ride_id, timestamp)
    )`

  create_promo_codes `CREATE TABLE IF NOT EXISTS promo_codes (
      code TEXT NOT NULL PRIMARY KEY,
      description TEXT,
      creation_time TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      expiration_time TIMESTAMP NOT NULL,
      rules TEXT
    )`

  create_user_promo_codes `CREATE TABLE IF NOT EXISTS user_promo_codes (
      city TEXT NOT NULL,
      user_id TEXT NOT NULL,
      code TEXT NOT NULL,
      timestamp TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      usage_count INTEGER NOT NULL DEFAULT 0,
      PRIMARY KEY (city, user_id, code)
    )`
}

seed {
  populate_users `INSERT INTO users (city, name, address, credit_card)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    SELECT
      CASE abs(random()) % 9
        WHEN 0 THEN 'new york'      WHEN 1 THEN 'boston'
        WHEN 2 THEN 'washington dc' WHEN 3 THEN 'seattle'
        WHEN 4 THEN 'san francisco' WHEN 5 THEN 'los angeles'
        WHEN 6 THEN 'chicago'       WHEN 7 THEN 'detroit'
        ELSE 'minneapolis'
      END,
      substr(hex(randomblob(16)), 1, 12),
      substr(hex(randomblob(16)), 1, 20) || ' St',
      substr('0000' || (abs(random()) % 10000), -4) ||
        substr('0000' || (abs(random()) % 10000), -4) ||
        substr('0000' || (abs(random()) % 10000), -4) ||
        substr('0000' || (abs(random()) % 10000), -4)
    FROM seq` (
    batch(num_users / batch_size),
    batch_size
  )

  populate_vehicles `INSERT INTO vehicles (city, owner_id, current_location, ext)
    SELECT
      u.city, u.id,
      substr(hex(randomblob(16)), 1, 20) || ' Ave',
      json_object(
        'color', CASE abs(random()) % 5
                   WHEN 0 THEN 'red'   WHEN 1 THEN 'blue' WHEN 2 THEN 'black'
                   WHEN 3 THEN 'white' ELSE 'silver'
                 END,
        'brand', CASE abs(random()) % 5
                   WHEN 0 THEN 'toyota' WHEN 1 THEN 'honda' WHEN 2 THEN 'ford'
                   WHEN 3 THEN 'tesla'  ELSE 'bmw'
                 END
      )
    FROM users u
    ORDER BY random()
    LIMIT $1` (num_vehicles)

  populate_rides `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id,
      start_address, end_address, start_time, end_time, revenue)
    SELECT
      u.city, v.city, u.id, v.id,
      substr(hex(randomblob(16)), 1, 20) || ' Blvd',
      substr(hex(randomblob(16)), 1, 20) || ' Rd',
      datetime('now', '-' || (abs(random()) % 30) || ' days'),
      datetime('now', '-' || (abs(random()) % 15) || ' days'),
      round(abs(random()) % 1000000 / 1000000.0 * 50 + 5, 2)
    FROM (SELECT city, id FROM users ORDER BY random() LIMIT $1) u
    CROSS JOIN (SELECT city, id FROM vehicles ORDER BY random() LIMIT 1) v` (num_rides)

  populate_promo_codes `INSERT INTO promo_codes (code, description, expiration_time, rules)
    WITH RECURSIVE seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $1
    )
    SELECT
      upper(substr(hex(randomblob(16)), 1, 8)),
      'Promo ' || s || ': save on your next ride',
      datetime('now', '+' || (abs(random()) % 90) || ' days'),
      json_object('discount_pct', abs(random()) % 30 + 5)
    FROM seq` (num_promo_codes)
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `SELECT id, city FROM users ORDER BY random()`

  fetch_vehicles(type: query) `SELECT id, city FROM vehicles ORDER BY random()`

  fetch_rides(type: query) `SELECT id, city FROM rides ORDER BY random()`

  fetch_promo_codes(type: query) `SELECT code FROM promo_codes ORDER BY random()`
}

run {
  read_vehicles(type: query) `SELECT id, city, owner_id, status, current_location
    FROM vehicles
    WHERE city = ?
    LIMIT 10` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `SELECT id, vehicle_id, start_address, end_address,
      start_time, end_time, revenue
    FROM rides
    WHERE city = ? AND rider_id = ?
    ORDER BY start_time DESC
    LIMIT 10` (
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: exec) `INSERT INTO rides (id, city, vehicle_city, rider_id, vehicle_id, start_address)
    VALUES (?, ?, ?, ?, ?, ?)` (
    uuid_v4(),
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles').id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `UPDATE rides SET
      end_address = ?,
      end_time = datetime('now'),
      revenue = ? / 100
    WHERE city = ? AND id = ?` (
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000'),
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id
  )

  add_vehicle_location(type: exec) `INSERT INTO vehicle_location_histories (city, ride_id, timestamp, lat, lng)
    VALUES (?, ?, strftime('%Y-%m-%d %H:%M:%f', 'now'), ?, ?)` (
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id,
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `INSERT INTO user_promo_codes (city, user_id, code, usage_count)
    VALUES (?, ?, ?, 1)
    ON CONFLICT(city, user_id, code) DO UPDATE SET usage_count = usage_count + 1` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_promo_codes').code
  )
}

deseed {
  delete_user_promo_codes(type: exec) `DELETE FROM user_promo_codes`

  delete_vehicle_location_histories(type: exec) `DELETE FROM vehicle_location_histories`

  delete_rides(type: exec) `DELETE FROM rides`

  delete_vehicles(type: exec) `DELETE FROM vehicles`

  delete_promo_codes(type: exec) `DELETE FROM promo_codes`

  delete_users(type: exec) `DELETE FROM users`
}

down {
  drop_user_promo_codes(type: exec) `DROP TABLE IF EXISTS user_promo_codes`

  drop_vehicle_location_histories(type: exec) `DROP TABLE IF EXISTS vehicle_location_histories`

  drop_rides(type: exec) `DROP TABLE IF EXISTS rides`

  drop_vehicles(type: exec) `DROP TABLE IF EXISTS vehicles`

  drop_promo_codes(type: exec) `DROP TABLE IF EXISTS promo_codes`

  drop_users(type: exec) `DROP TABLE IF EXISTS users`
}

expect {
  error_rate < 1
}
