let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE users (
          id VARCHAR2(32) DEFAULT RAWTOHEX(SYS_GUID()) NOT NULL,
          city VARCHAR2(50) NOT NULL,
          name VARCHAR2(100) NOT NULL,
          address VARCHAR2(255) NOT NULL,
          credit_card VARCHAR2(19) NOT NULL,
          PRIMARY KEY (city, id)
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`

  create_vehicles(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE vehicles (
          id VARCHAR2(32) DEFAULT RAWTOHEX(SYS_GUID()) NOT NULL,
          city VARCHAR2(50) NOT NULL,
          owner_id VARCHAR2(32) NOT NULL,
          creation_time TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
          status VARCHAR2(20) DEFAULT ''available'' NOT NULL,
          current_location VARCHAR2(255) NOT NULL,
          ext CLOB,
          PRIMARY KEY (city, id)
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`

  create_rides(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE rides (
          id VARCHAR2(32) DEFAULT RAWTOHEX(SYS_GUID()) NOT NULL,
          city VARCHAR2(50) NOT NULL,
          vehicle_city VARCHAR2(50) NOT NULL,
          rider_id VARCHAR2(32) NOT NULL,
          vehicle_id VARCHAR2(32) NOT NULL,
          start_address VARCHAR2(255) NOT NULL,
          end_address VARCHAR2(255),
          start_time TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
          end_time TIMESTAMP,
          revenue NUMBER(10,2),
          PRIMARY KEY (city, id)
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`

  create_vehicle_location_histories(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE vehicle_location_histories (
          city VARCHAR2(50) NOT NULL,
          ride_id VARCHAR2(32) NOT NULL,
          "TIMESTAMP" TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
          lat NUMBER NOT NULL,
          "LONG" NUMBER NOT NULL,
          PRIMARY KEY (city, ride_id, "TIMESTAMP")
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`

  create_promo_codes(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE promo_codes (
          code VARCHAR2(20) NOT NULL PRIMARY KEY,
          description VARCHAR2(255),
          creation_time TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
          expiration_time TIMESTAMP NOT NULL,
          rules CLOB
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`

  create_user_promo_codes(type: exec) `BEGIN
      EXECUTE IMMEDIATE '
        CREATE TABLE user_promo_codes (
          city VARCHAR2(50) NOT NULL,
          user_id VARCHAR2(32) NOT NULL,
          code VARCHAR2(20) NOT NULL,
          "TIMESTAMP" TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
          usage_count NUMBER DEFAULT 0 NOT NULL,
          PRIMARY KEY (city, user_id, code)
        )
      ';
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != -955 THEN RAISE; END IF;
    END;`
}

seed {
  populate_users `INSERT INTO users (city, name, address, credit_card)
    SELECT
      CASE FLOOR(DBMS_RANDOM.VALUE(1, 10))
        WHEN 1 THEN 'new york'
        WHEN 2 THEN 'boston'
        WHEN 3 THEN 'washington dc'
        WHEN 4 THEN 'seattle'
        WHEN 5 THEN 'san francisco'
        WHEN 6 THEN 'los angeles'
        WHEN 7 THEN 'chicago'
        WHEN 8 THEN 'detroit'
        WHEN 9 THEN 'minneapolis'
      END,
      DBMS_RANDOM.STRING('x', 12),
      DBMS_RANDOM.STRING('x', 20) || ' St',
      LPAD(FLOOR(DBMS_RANDOM.VALUE(0, 10000)), 4, '0') ||
      LPAD(FLOOR(DBMS_RANDOM.VALUE(0, 10000)), 4, '0') ||
      LPAD(FLOOR(DBMS_RANDOM.VALUE(0, 10000)), 4, '0') ||
      LPAD(FLOOR(DBMS_RANDOM.VALUE(0, 10000)), 4, '0')
    FROM DUAL CONNECT BY LEVEL <= $2` (
    batch(num_users / batch_size),
    batch_size
  )

  populate_vehicles `INSERT INTO vehicles (city, owner_id, current_location, ext)
    SELECT city, id,
      DBMS_RANDOM.STRING('x', 20) || ' Ave',
      '{"color":"blue","brand":"toyota"}'
    FROM (SELECT city, id FROM users ORDER BY DBMS_RANDOM.VALUE)
    WHERE ROWNUM <= $1` (num_vehicles)

  populate_rides `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id,
      start_address, end_address, start_time, end_time, revenue)
    SELECT u.city, v.city, u.id, v.id,
      DBMS_RANDOM.STRING('x', 20) || ' Blvd',
      DBMS_RANDOM.STRING('x', 20) || ' Rd',
      SYSTIMESTAMP - NUMTODSINTERVAL(DBMS_RANDOM.VALUE(0, 30) * 86400, 'SECOND'),
      SYSTIMESTAMP - NUMTODSINTERVAL(DBMS_RANDOM.VALUE(0, 15) * 86400, 'SECOND'),
      ROUND(DBMS_RANDOM.VALUE(5, 55), 2)
    FROM (SELECT city, id FROM users ORDER BY DBMS_RANDOM.VALUE) u
    CROSS JOIN (SELECT city, id FROM vehicles ORDER BY DBMS_RANDOM.VALUE FETCH FIRST 1 ROW ONLY) v
    WHERE ROWNUM <= $1` (num_rides)

  populate_promo_codes `INSERT INTO promo_codes (code, description, expiration_time, rules)
    SELECT
      DBMS_RANDOM.STRING('U', 8),
      'Promo ' || LEVEL || ': save on your next ride',
      SYSTIMESTAMP + NUMTODSINTERVAL(DBMS_RANDOM.VALUE(1, 90) * 86400, 'SECOND'),
      '{"discount_pct":' || FLOOR(DBMS_RANDOM.VALUE(5, 35)) || '}'
    FROM DUAL CONNECT BY LEVEL <= $1` (num_promo_codes)
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `SELECT id, city FROM users`

  fetch_vehicles(type: query) `SELECT id, city FROM vehicles`

  fetch_rides(type: query) `SELECT id, city FROM rides`

  fetch_promo_codes(type: query) `SELECT code FROM promo_codes`
}

run {
  read_vehicles(type: query) `SELECT id, city, owner_id, status, current_location
    FROM vehicles
    WHERE city = :1
    FETCH FIRST 10 ROWS ONLY` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `SELECT id, vehicle_id, start_address, end_address,
      start_time, end_time, revenue
    FROM rides
    WHERE city = :2 AND rider_id = :1
    ORDER BY start_time DESC
    FETCH FIRST 10 ROWS ONLY` (
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: exec) `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id, start_address)
    VALUES (:1, :3, :2, :4, :5)` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles').id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `UPDATE rides SET
      end_address = :3,
      end_time = SYSTIMESTAMP,
      revenue = :4 / 100
    WHERE city = :2 AND id = :1` (
    uniform.ref('fetch_rides').id,
    uniform.ref('fetch_rides').city,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000')
  )

  add_vehicle_location(type: exec) `INSERT INTO vehicle_location_histories (city, ride_id, lat, "LONG")
    VALUES (:1, :2, :3, :4)` (
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id,
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `MERGE INTO user_promo_codes t
    USING (SELECT :1 AS city, :2 AS user_id, :3 AS code FROM DUAL) s
    ON (t.city = s.city AND t.user_id = s.user_id AND t.code = s.code)
    WHEN MATCHED THEN UPDATE SET usage_count = usage_count + 1
    WHEN NOT MATCHED THEN INSERT (city, user_id, code, usage_count)
      VALUES (s.city, s.user_id, s.code, 1)` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_promo_codes').code
  )
}

deseed {
  truncate_user_promo_codes(type: exec) `TRUNCATE TABLE user_promo_codes`

  truncate_vehicle_location_histories(type: exec) `TRUNCATE TABLE vehicle_location_histories`

  truncate_rides(type: exec) `TRUNCATE TABLE rides`

  truncate_vehicles(type: exec) `TRUNCATE TABLE vehicles`

  truncate_promo_codes(type: exec) `TRUNCATE TABLE promo_codes`

  truncate_users(type: exec) `TRUNCATE TABLE users`
}

down {
  drop_user_promo_codes(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE user_promo_codes PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`

  drop_vehicle_location_histories(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE vehicle_location_histories PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`

  drop_rides(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE rides PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`

  drop_vehicles(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE vehicles PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`

  drop_promo_codes(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE promo_codes PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`

  drop_users(type: exec) `BEGIN EXECUTE IMMEDIATE 'DROP TABLE users PURGE';
    EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF; END;`
}

expect {
  error_rate < 1
}
