let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users `IF OBJECT_ID('users', 'U') IS NULL
    CREATE TABLE users (
      id UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID(),
      city NVARCHAR(50) NOT NULL,
      name NVARCHAR(100) NOT NULL,
      address NVARCHAR(255) NOT NULL,
      credit_card NVARCHAR(19) NOT NULL,
      PRIMARY KEY (city, id)
    )`

  create_vehicles `IF OBJECT_ID('vehicles', 'U') IS NULL
    CREATE TABLE vehicles (
      id UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID(),
      city NVARCHAR(50) NOT NULL,
      owner_id UNIQUEIDENTIFIER NOT NULL,
      creation_time DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(),
      status NVARCHAR(20) NOT NULL DEFAULT 'available',
      current_location NVARCHAR(255) NOT NULL,
      ext NVARCHAR(MAX),
      PRIMARY KEY (city, id)
    )`

  create_rides `IF OBJECT_ID('rides', 'U') IS NULL
    CREATE TABLE rides (
      id UNIQUEIDENTIFIER NOT NULL DEFAULT NEWID(),
      city NVARCHAR(50) NOT NULL,
      vehicle_city NVARCHAR(50) NOT NULL,
      rider_id UNIQUEIDENTIFIER NOT NULL,
      vehicle_id UNIQUEIDENTIFIER NOT NULL,
      start_address NVARCHAR(255) NOT NULL,
      end_address NVARCHAR(255),
      start_time DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(),
      end_time DATETIME2,
      revenue DECIMAL(10,2),
      PRIMARY KEY (city, id)
    )`

  create_vehicle_location_histories `IF OBJECT_ID('vehicle_location_histories', 'U') IS NULL
    CREATE TABLE vehicle_location_histories (
      city NVARCHAR(50) NOT NULL,
      ride_id UNIQUEIDENTIFIER NOT NULL,
      timestamp DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(),
      lat FLOAT NOT NULL,
      long FLOAT NOT NULL,
      PRIMARY KEY (city, ride_id, timestamp)
    )`

  create_promo_codes `IF OBJECT_ID('promo_codes', 'U') IS NULL
    CREATE TABLE promo_codes (
      code NVARCHAR(20) NOT NULL PRIMARY KEY,
      description NVARCHAR(255),
      creation_time DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(),
      expiration_time DATETIME2 NOT NULL,
      rules NVARCHAR(MAX)
    )`

  create_user_promo_codes `IF OBJECT_ID('user_promo_codes', 'U') IS NULL
    CREATE TABLE user_promo_codes (
      city NVARCHAR(50) NOT NULL,
      user_id UNIQUEIDENTIFIER NOT NULL,
      code NVARCHAR(20) NOT NULL,
      timestamp DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME(),
      usage_count INT NOT NULL DEFAULT 0,
      PRIMARY KEY (city, user_id, code)
    )`
}

seed {
  populate_users `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $2
    )
    INSERT INTO users (city, name, address, credit_card)
    SELECT
      c.city,
      LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 12),
      CONCAT(LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 20), ' St'),
      CONCAT(
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS NVARCHAR), 4),
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS NVARCHAR), 4),
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS NVARCHAR), 4),
        RIGHT('0000' + CAST(CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 10000) AS INT) AS NVARCHAR), 4))
    FROM seq
    CROSS APPLY (
      SELECT TOP 1 city FROM (
        VALUES ('new york'),('boston'),('washington dc'),('seattle'),
        ('san francisco'),('los angeles'),('chicago'),
        ('detroit'),('minneapolis')
      ) AS cities(city)
      ORDER BY NEWID()
    ) c
    OPTION (MAXRECURSION 10000)` (
    batch(num_users / batch_size),
    batch_size
  )

  populate_vehicles `INSERT INTO vehicles (city, owner_id, current_location, ext)
    SELECT TOP($1)
      city, id,
      CONCAT(LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 20), ' Ave'),
      '{"color":"blue","brand":"toyota"}'
    FROM users
    ORDER BY NEWID()` (num_vehicles)

  populate_rides `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id,
      start_address, end_address, start_time, end_time, revenue)
    SELECT
      u.city, v.city, u.id, v.id,
      CONCAT(LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 20), ' Blvd'),
      CONCAT(LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 20), ' Rd'),
      DATEADD(SECOND, -CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 30 * 86400) AS INT), SYSUTCDATETIME()),
      DATEADD(SECOND, -CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 15 * 86400) AS INT), SYSUTCDATETIME()),
      CAST(ROUND(RAND(CHECKSUM(NEWID())) * 50 + 5, 2) AS DECIMAL(10,2))
    FROM (SELECT TOP($1) city, id FROM users ORDER BY NEWID()) u
    CROSS JOIN (SELECT TOP 1 city, id FROM vehicles ORDER BY NEWID()) v` (num_rides)

  populate_promo_codes `WITH seq AS (
      SELECT 1 AS s UNION ALL SELECT s + 1 FROM seq WHERE s < $1
    )
    INSERT INTO promo_codes (code, description, expiration_time, rules)
    SELECT
      UPPER(LEFT(REPLACE(CONVERT(NVARCHAR(36), NEWID()), '-', ''), 8)),
      CONCAT('Promo ', s, ': save on your next ride'),
      DATEADD(DAY, CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 90) AS INT) + 1, SYSUTCDATETIME()),
      CONCAT('{"discount_pct":', CAST(FLOOR(RAND(CHECKSUM(NEWID())) * 30) AS INT) + 5, '}')
    FROM seq
    OPTION (MAXRECURSION 10000)` (num_promo_codes)
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `SELECT id, city FROM users ORDER BY NEWID()`

  fetch_vehicles(type: query) `SELECT id, city FROM vehicles ORDER BY NEWID()`

  fetch_rides(type: query) `SELECT id, city FROM rides ORDER BY NEWID()`

  fetch_promo_codes(type: query) `SELECT code FROM promo_codes ORDER BY NEWID()`
}

run {
  read_vehicles(type: query) `SELECT TOP 10 id, city, owner_id, status, current_location
    FROM vehicles
    WHERE city = @p1` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `SELECT TOP 10 id, vehicle_id, start_address, end_address,
      start_time, end_time, revenue
    FROM rides
    WHERE city = @p2 AND rider_id = @p1
    ORDER BY start_time DESC` (
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: exec) `INSERT INTO rides (id, city, vehicle_city, rider_id, vehicle_id, start_address)
    VALUES (@p1, @p2, @p4, @p3, @p5, @p6)` (
    uuid_v4(),
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles').id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `UPDATE rides SET
      end_address = @p1,
      end_time = SYSUTCDATETIME(),
      revenue = CAST(@p2 AS DECIMAL(10,2)) / 100
    WHERE city = @p3 AND id = @p4` (
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000'),
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id
  )

  add_vehicle_location(type: exec) `INSERT INTO vehicle_location_histories (city, ride_id, lat, long)
    VALUES (@p1, @p2, @p3, @p4)` (
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id,
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `MERGE user_promo_codes AS t
    USING (SELECT @p1 AS city, @p2 AS user_id, @p3 AS code) AS s
    ON t.city = s.city AND t.user_id = s.user_id AND t.code = s.code
    WHEN MATCHED THEN UPDATE SET usage_count = usage_count + 1
    WHEN NOT MATCHED THEN INSERT (city, user_id, code, usage_count)
      VALUES (s.city, s.user_id, s.code, 1);` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_promo_codes').code
  )
}

deseed {
  delete_user_promo_codes(type: exec) `DELETE FROM user_promo_codes`

  delete_vehicle_location_histories(type: exec) `DELETE FROM vehicle_location_histories`

  delete_rides(type: exec) `DELETE FROM rides`

  delete_vehicles(type: exec) `DELETE FROM vehicles`

  delete_promo_codes(type: exec) `DELETE FROM promo_codes`

  delete_users(type: exec) `DELETE FROM users`
}

down {
  drop_user_promo_codes(type: exec) `DROP TABLE IF EXISTS user_promo_codes`

  drop_vehicle_location_histories(type: exec) `DROP TABLE IF EXISTS vehicle_location_histories`

  drop_rides(type: exec) `DROP TABLE IF EXISTS rides`

  drop_vehicles(type: exec) `DROP TABLE IF EXISTS vehicles`

  drop_promo_codes(type: exec) `DROP TABLE IF EXISTS promo_codes`

  drop_users(type: exec) `DROP TABLE IF EXISTS users`
}

expect {
  error_rate < 1
}
