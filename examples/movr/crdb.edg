let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users `CREATE TABLE IF NOT EXISTS users (
      id UUID NOT NULL DEFAULT gen_random_uuid(),
      city STRING NOT NULL,
      name STRING NOT NULL,
      address STRING NOT NULL,
      credit_card STRING NOT NULL,
      PRIMARY KEY (city, id)
    )`

  create_vehicles `CREATE TABLE IF NOT EXISTS vehicles (
      id UUID NOT NULL DEFAULT gen_random_uuid(),
      city STRING NOT NULL,
      owner_id UUID NOT NULL,
      creation_time TIMESTAMPTZ NOT NULL DEFAULT now(),
      status STRING NOT NULL DEFAULT 'available',
      current_location STRING NOT NULL,
      ext JSONB,
      PRIMARY KEY (city, id)
    )`

  create_rides `CREATE TABLE IF NOT EXISTS rides (
      id UUID NOT NULL DEFAULT gen_random_uuid(),
      city STRING NOT NULL,
      vehicle_city STRING NOT NULL,
      rider_id UUID NOT NULL,
      vehicle_id UUID NOT NULL,
      start_address STRING NOT NULL,
      end_address STRING,
      start_time TIMESTAMPTZ NOT NULL DEFAULT now(),
      end_time TIMESTAMPTZ,
      revenue DECIMAL(10,2),
      PRIMARY KEY (city, id)
    )`

  create_vehicle_location_histories `CREATE TABLE IF NOT EXISTS vehicle_location_histories (
      city STRING NOT NULL,
      ride_id UUID NOT NULL,
      timestamp TIMESTAMPTZ NOT NULL DEFAULT now(),
      lat FLOAT8 NOT NULL,
      long FLOAT8 NOT NULL,
      PRIMARY KEY (city, ride_id, timestamp)
    )`

  create_promo_codes `CREATE TABLE IF NOT EXISTS promo_codes (
      code STRING NOT NULL PRIMARY KEY,
      description STRING,
      creation_time TIMESTAMPTZ NOT NULL DEFAULT now(),
      expiration_time TIMESTAMPTZ NOT NULL,
      rules JSONB
    )`

  create_user_promo_codes `CREATE TABLE IF NOT EXISTS user_promo_codes (
      city STRING NOT NULL,
      user_id UUID NOT NULL,
      code STRING NOT NULL,
      timestamp TIMESTAMPTZ NOT NULL DEFAULT now(),
      usage_count INT NOT NULL DEFAULT 0,
      PRIMARY KEY (city, user_id, code)
    )`
}

seed {
  populate_users `INSERT INTO users (city, name, address, credit_card)
    SELECT
      (ARRAY['new york','boston','washington dc','seattle',
             'san francisco','los angeles','chicago',
             'detroit','minneapolis'])[floor(random()::FLOAT8 * 9 + 1)::INT],
      substr(md5(random()::FLOAT8::text), 1, 12),
      substr(md5(random()::FLOAT8::text), 1, 20) || ' St',
      lpad(floor(random()::FLOAT8 * 10000)::INT::TEXT, 4, '0') ||
      lpad(floor(random()::FLOAT8 * 10000)::INT::TEXT, 4, '0') ||
      lpad(floor(random()::FLOAT8 * 10000)::INT::TEXT, 4, '0') ||
      lpad(floor(random()::FLOAT8 * 10000)::INT::TEXT, 4, '0')
    FROM generate_series(1, $2::INT) AS s` (
    batch(num_users / batch_size),
    batch_size
  )

  populate_vehicles `INSERT INTO vehicles (city, owner_id, current_location, ext)
    SELECT
      u.city, u.id,
      substr(md5(random()::FLOAT8::text), 1, 20) || ' Ave',
      json_build_object(
        'color', (ARRAY['red','blue','black','white','silver'])[floor(random()::FLOAT8 * 5 + 1)::INT],
        'brand', (ARRAY['toyota','honda','ford','tesla','bmw'])[floor(random()::FLOAT8 * 5 + 1)::INT]
      )
    FROM users u
    ORDER BY random()::FLOAT8
    LIMIT $1::INT` (num_vehicles)

  populate_rides `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id,
      start_address, end_address, start_time, end_time, revenue)
    SELECT
      u.city, v.city, u.id, v.id,
      substr(md5(random()::FLOAT8::text), 1, 20) || ' Blvd',
      substr(md5(random()::FLOAT8::text), 1, 20) || ' Rd',
      now() - (random()::FLOAT8 * 86400 * 30)::INT * INTERVAL '1 second',
      now() - (random()::FLOAT8 * 86400 * 15)::INT * INTERVAL '1 second',
      (random()::FLOAT8 * 50 + 5)::DECIMAL(10,2)
    FROM (SELECT city, id FROM users ORDER BY random()::FLOAT8 LIMIT $1::INT) u
    CROSS JOIN LATERAL (
      SELECT city, id FROM vehicles ORDER BY random()::FLOAT8 LIMIT 1
    ) v` (num_rides)

  populate_promo_codes `INSERT INTO promo_codes (code, description, expiration_time, rules)
    SELECT
      upper(substr(md5(random()::FLOAT8::text), 1, 8)),
      'Promo ' || s || ': save on your next ride',
      now() + (random()::FLOAT8 * 86400 * 90)::INT * INTERVAL '1 second',
      json_build_object('discount_pct', floor(random()::FLOAT8 * 30 + 5)::INT)
    FROM generate_series(1, $1::INT) AS s` (num_promo_codes)
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `SELECT id, city FROM users ORDER BY random()`

  fetch_vehicles(type: query) `SELECT id, city FROM vehicles ORDER BY random()`

  fetch_rides(type: query) `SELECT id, city FROM rides ORDER BY random()`

  fetch_promo_codes(type: query) `SELECT code FROM promo_codes ORDER BY random()`
}

run {
  read_vehicles(type: query) `SELECT id, city, owner_id, status, current_location
    FROM vehicles
    WHERE city = $1
    LIMIT 10` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `SELECT id, vehicle_id, start_address, end_address,
      start_time, end_time, revenue
    FROM rides
    WHERE city = $2 AND rider_id = $1::UUID
    ORDER BY start_time DESC
    LIMIT 10` (
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: query) `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id, start_address)
    VALUES ($1, $3, $2::UUID, $4::UUID, $5)
    RETURNING id` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles').id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `UPDATE rides SET
      end_address = $3,
      end_time = now(),
      revenue = $4::DECIMAL / 100
    WHERE city = $2 AND id = $1::UUID` (
    uniform.ref('fetch_rides').id,
    uniform.ref('fetch_rides').city,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000')
  )

  add_vehicle_location(type: exec) `INSERT INTO vehicle_location_histories (city, ride_id, lat, long)
    VALUES ($1, $2::UUID, $3::FLOAT8, $4::FLOAT8)` (
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id,
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `UPSERT INTO user_promo_codes (city, user_id, code, usage_count)
    VALUES ($1, $2::UUID, $3, 1)` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_promo_codes').code
  )
}

deseed {
  truncate_user_promo_codes(type: exec) `TRUNCATE TABLE user_promo_codes`

  truncate_vehicle_location_histories(type: exec) `TRUNCATE TABLE vehicle_location_histories`

  truncate_rides(type: exec) `TRUNCATE TABLE rides`

  truncate_vehicles(type: exec) `TRUNCATE TABLE vehicles`

  truncate_promo_codes(type: exec) `TRUNCATE TABLE promo_codes`

  truncate_users(type: exec) `TRUNCATE TABLE users`
}

down {
  drop_user_promo_codes(type: exec) `DROP TABLE IF EXISTS user_promo_codes`

  drop_vehicle_location_histories(type: exec) `DROP TABLE IF EXISTS vehicle_location_histories`

  drop_rides(type: exec) `DROP TABLE IF EXISTS rides`

  drop_vehicles(type: exec) `DROP TABLE IF EXISTS vehicles`

  drop_promo_codes(type: exec) `DROP TABLE IF EXISTS promo_codes`

  drop_users(type: exec) `DROP TABLE IF EXISTS users`
}

expect {
  error_rate < 1
}
