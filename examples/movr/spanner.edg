let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users `CREATE TABLE IF NOT EXISTS users (
      id STRING(36) NOT NULL DEFAULT (GENERATE_UUID()),
      city STRING(50) NOT NULL,
      name STRING(100) NOT NULL,
      address STRING(200) NOT NULL,
      credit_card STRING(20) NOT NULL
    ) PRIMARY KEY (city, id)`

  create_vehicles `CREATE TABLE IF NOT EXISTS vehicles (
      id STRING(36) NOT NULL DEFAULT (GENERATE_UUID()),
      city STRING(50) NOT NULL,
      owner_id STRING(36) NOT NULL,
      creation_time TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP()),
      status STRING(20) NOT NULL DEFAULT ('available'),
      current_location STRING(200) NOT NULL,
      ext JSON
    ) PRIMARY KEY (city, id)`

  create_rides `CREATE TABLE IF NOT EXISTS rides (
      id STRING(36) NOT NULL DEFAULT (GENERATE_UUID()),
      city STRING(50) NOT NULL,
      vehicle_city STRING(50) NOT NULL,
      rider_id STRING(36) NOT NULL,
      vehicle_id STRING(36) NOT NULL,
      start_address STRING(200) NOT NULL,
      end_address STRING(200),
      start_time TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP()),
      end_time TIMESTAMP,
      revenue NUMERIC
    ) PRIMARY KEY (city, id)`

  create_vehicle_location_histories `CREATE TABLE IF NOT EXISTS vehicle_location_histories (
      city STRING(50) NOT NULL,
      ride_id STRING(36) NOT NULL,
      ts TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP()),
      lat FLOAT64 NOT NULL,
      lng FLOAT64 NOT NULL
    ) PRIMARY KEY (city, ride_id, ts)`

  create_promo_codes `CREATE TABLE IF NOT EXISTS promo_codes (
      code STRING(20) NOT NULL,
      description STRING(MAX),
      creation_time TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP()),
      expiration_time TIMESTAMP NOT NULL,
      rules JSON
    ) PRIMARY KEY (code)`

  create_user_promo_codes `CREATE TABLE IF NOT EXISTS user_promo_codes (
      city STRING(50) NOT NULL,
      user_id STRING(36) NOT NULL,
      code STRING(20) NOT NULL,
      ts TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP()),
      usage_count INT64 NOT NULL DEFAULT (0)
    ) PRIMARY KEY (city, user_id, code)`
}

seed {
  populate_users `INSERT INTO users (city, name, address, credit_card)
    SELECT
      (ARRAY<STRING>['new york','boston','washington dc','seattle',
             'san francisco','los angeles','chicago',
             'detroit','minneapolis'])[OFFSET(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 9))],
      SUBSTR(GENERATE_UUID(), 1, 12),
      CONCAT(SUBSTR(GENERATE_UUID(), 1, 20), ' St'),
      CONCAT(
        LPAD(CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 10000) AS STRING), 4, '0'),
        LPAD(CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 10000) AS STRING), 4, '0'),
        LPAD(CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 10000) AS STRING), 4, '0'),
        LPAD(CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 10000) AS STRING), 4, '0')
      )
    FROM UNNEST(GENERATE_ARRAY(1, $2)) AS s` (
    batch(num_users / batch_size),
    batch_size
  )

  populate_vehicles `INSERT INTO vehicles (city, owner_id, current_location, ext)
    SELECT
      u.city, u.id,
      CONCAT(SUBSTR(GENERATE_UUID(), 1, 20), ' Ave'),
      JSON_OBJECT(
        'color', (ARRAY<STRING>['red','blue','black','white','silver'])[OFFSET(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 5))],
        'brand', (ARRAY<STRING>['toyota','honda','ford','tesla','bmw'])[OFFSET(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 5))]
      )
    FROM users u
    ORDER BY FARM_FINGERPRINT(u.id)
    LIMIT $1` (num_vehicles)

  populate_rides `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id,
      start_address, end_address, start_time, end_time, revenue)
    SELECT
      u.city, v.city, u.id, v.id,
      CONCAT(SUBSTR(GENERATE_UUID(), 1, 20), ' Blvd'),
      CONCAT(SUBSTR(GENERATE_UUID(), 1, 20), ' Rd'),
      TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 30 * 86400) AS INT64) SECOND),
      TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 15 * 86400) AS INT64) SECOND),
      CAST(ROUND(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 5000) / 100.0 + 5, 2) AS NUMERIC)
    FROM (SELECT city, id FROM users ORDER BY FARM_FINGERPRINT(id) LIMIT $1) u
    CROSS JOIN (
      SELECT city, id FROM vehicles ORDER BY FARM_FINGERPRINT(id) LIMIT 1
    ) v` (num_rides)

  populate_promo_codes `INSERT INTO promo_codes (code, description, expiration_time, rules)
    SELECT
      UPPER(SUBSTR(GENERATE_UUID(), 1, 8)),
      CONCAT('Promo ', CAST(s AS STRING), ': save on your next ride'),
      TIMESTAMP_ADD(CURRENT_TIMESTAMP(), INTERVAL CAST(MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 90) AS INT64) DAY),
      JSON_OBJECT('discount_pct', MOD(ABS(FARM_FINGERPRINT(GENERATE_UUID())), 30) + 5)
    FROM UNNEST(GENERATE_ARRAY(1, $1)) AS s` (num_promo_codes)
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `SELECT id, city FROM users TABLESAMPLE RESERVOIR (1000 ROWS)`

  fetch_vehicles(type: query) `SELECT id, city FROM vehicles TABLESAMPLE RESERVOIR (500 ROWS)`

  fetch_rides(type: query) `SELECT id, city FROM rides TABLESAMPLE RESERVOIR (1000 ROWS)`

  fetch_promo_codes(type: query) `SELECT code FROM promo_codes TABLESAMPLE RESERVOIR (100 ROWS)`
}

run {
  read_vehicles(type: query) `SELECT id, city, owner_id, status, current_location
    FROM vehicles
    WHERE city = $1
    LIMIT 10` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `SELECT id, vehicle_id, start_address, end_address,
      start_time, end_time, revenue
    FROM rides
    WHERE city = $2 AND rider_id = $1
    ORDER BY start_time DESC
    LIMIT 10` (
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: exec) `INSERT INTO rides (city, vehicle_city, rider_id, vehicle_id, start_address)
    VALUES ($1, $3, $2, $4, $5)` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles').id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `UPDATE rides SET
      end_address = $3,
      end_time = CURRENT_TIMESTAMP(),
      revenue = CAST($4 AS NUMERIC) / 100
    WHERE city = $2 AND id = $1` (
    uniform.ref('fetch_rides').id,
    uniform.ref('fetch_rides').city,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000')
  )

  add_vehicle_location(type: exec) `INSERT INTO vehicle_location_histories (city, ride_id, lat, lng)
    VALUES ($1, $2, $3, $4)` (
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides').id,
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `INSERT OR UPDATE INTO user_promo_codes (city, user_id, code, usage_count)
    VALUES ($1, $2, $3, 1)` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users').id,
    uniform.ref('fetch_promo_codes').code
  )
}

deseed {
  delete_user_promo_codes(type: exec) `DELETE FROM user_promo_codes WHERE TRUE`

  delete_vehicle_location_histories(type: exec) `DELETE FROM vehicle_location_histories WHERE TRUE`

  delete_rides(type: exec) `DELETE FROM rides WHERE TRUE`

  delete_vehicles(type: exec) `DELETE FROM vehicles WHERE TRUE`

  delete_promo_codes(type: exec) `DELETE FROM promo_codes WHERE TRUE`

  delete_users(type: exec) `DELETE FROM users WHERE TRUE`
}

down {
  drop_user_promo_codes(type: exec) `DROP TABLE IF EXISTS user_promo_codes`

  drop_vehicle_location_histories(type: exec) `DROP TABLE IF EXISTS vehicle_location_histories`

  drop_rides(type: exec) `DROP TABLE IF EXISTS rides`

  drop_vehicles(type: exec) `DROP TABLE IF EXISTS vehicles`

  drop_promo_codes(type: exec) `DROP TABLE IF EXISTS promo_codes`

  drop_users(type: exec) `DROP TABLE IF EXISTS users`
}

expect {
  error_rate < 1
}
