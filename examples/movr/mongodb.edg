let num_users       = int(coalesce(env_nil('NUM_USERS'), 100))
let num_vehicles    = int(coalesce(env_nil('NUM_VEHICLES'), 50))
let num_rides       = int(coalesce(env_nil('NUM_RIDES'), 200))
let num_promo_codes = int(coalesce(env_nil('NUM_PROMO_CODES'), 10))
let batch_size      = int(coalesce(env_nil('BATCH_SIZE'), 100))

up {
  create_users(type: exec) `{"create": "users"}`

  create_vehicles(type: exec) `{"create": "vehicles"}`

  create_rides(type: exec) `{"create": "rides"}`

  create_vehicle_location_histories(type: exec) `{"create": "vehicle_location_histories"}`

  create_promo_codes(type: exec) `{"create": "promo_codes"}`

  create_user_promo_codes(type: exec) `{"create": "user_promo_codes"}`
}

seed {
  populate_users(type: exec_batch, count: num_users, size: batch_size) `{"insert": "users", "documents": [{"_id": {"$oid": "$1"}, "city": "$2", "name": "$3", "address": "$4", "credit_card": "$5"}]}` (
    objectid(),
    uniform.set(['new york', 'boston', 'washington dc', 'seattle', 'san francisco', 'los angeles', 'chicago', 'detroit', 'minneapolis'],[]),
    regex('[a-z]{12}'),
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    regex('[0-9]{16}')
  )

  fetch_users `{"find": "users", "filter": {}}`

  populate_vehicles(type: exec_batch, count: num_vehicles, size: batch_size) `{"insert": "vehicles", "documents": [{"_id": {"$oid": "$1"}, "city": "$2", "owner_id": {"$oid": "$3"}, "creation_time": "$4", "status": "available", "current_location": "$5", "ext": {}}]}` (
    objectid(),
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users')._id,
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z'),
    regex('[A-Z][a-z]{4,12} Ave')
  )

  fetch_vehicles `{"find": "vehicles", "filter": {}}`

  populate_rides(type: exec_batch, count: num_rides, size: batch_size) `{"insert": "rides", "documents": [{"_id": {"$oid": "$1"}, "city": "$2", "vehicle_city": "$3", "rider_id": {"$oid": "$4"}, "vehicle_id": {"$oid": "$5"}, "start_address": "$6", "end_address": "$7", "start_time": "$8", "end_time": "$9", "revenue": $10}]}` (
    objectid(),
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_users')._id,
    uniform.ref('fetch_vehicles')._id,
    regex('[A-Z][a-z]{4,12} Blvd'),
    regex('[A-Z][a-z]{4,12} Rd'),
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z'),
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z'),
    gen('number:500,5000')
  )

  populate_promo_codes(type: exec_batch, count: num_promo_codes, size: batch_size) `{"insert": "promo_codes", "documents": [{"_id": "$1", "description": "$2", "creation_time": "$3", "expiration_time": "$4", "rules": {}}]}` (
    regex('[A-Z0-9]{8}'),
    gen('sentence'),
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z'),
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z')
  )
}

weights {
  add_vehicle_location = 15
  apply_promo_code     = 10
  create_ride          = 20
  read_rides           = 20
  read_vehicles        = 20
  update_ride          = 15
}

init {
  fetch_users(type: query) `{"find": "users", "filter": {}}`

  fetch_vehicles(type: query) `{"find": "vehicles", "filter": {}}`

  fetch_rides(type: query) `{"find": "rides", "filter": {}}`

  fetch_promo_codes(type: query) `{"find": "promo_codes", "filter": {}, "projection": {"_id": 1}}`
}

run {
  read_vehicles(type: query) `{"find": "vehicles", "filter": {"city": "$1"}, "limit": 10}` (uniform.ref('fetch_vehicles').city)

  read_rides(type: query) `{"find": "rides", "filter": {"city": "$2", "rider_id": {"$oid": "$1"}}, "sort": {"start_time": -1}, "limit": 10}` (
    uniform.ref('fetch_users')._id,
    uniform.ref('fetch_users').city
  )

  create_ride(type: exec) `{"insert": "rides", "documents": [{"city": "$1", "vehicle_city": "$3", "rider_id": {"$oid": "$2"}, "vehicle_id": {"$oid": "$4"}, "start_address": "$5"}]}` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users')._id,
    uniform.ref('fetch_vehicles').city,
    uniform.ref('fetch_vehicles')._id,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)')
  )

  update_ride(type: exec) `{"update": "rides", "updates": [{"q": {"_id": {"$oid": "$1"}, "city": "$2"}, "u": {"$set": {"end_address": "$3", "revenue": $4}}}]}` (
    uniform.ref('fetch_rides')._id,
    uniform.ref('fetch_rides').city,
    regex('[A-Z][a-z]{4,12} (St|Ave|Blvd|Rd)'),
    gen('number:500,5000')
  )

  add_vehicle_location(type: exec) `{"insert": "vehicle_location_histories", "documents": [{"_id": {"$oid": "$1"}, "city": "$2", "ride_id": {"$oid": "$3"}, "timestamp": "$4", "lat": $5, "long": $6}]}` (
    objectid(),
    uniform.ref('fetch_rides').city,
    uniform.ref('fetch_rides')._id,
    timestamp('2020-01-01T00:00:00Z', '2025-01-01T00:00:00Z'),
    uniform.int(-90, 90),
    uniform.int(-180, 180)
  )

  apply_promo_code(type: exec) `{"update": "user_promo_codes", "updates": [{"q": {"city": "$1", "user_id": {"$oid": "$2"}, "code": "$3"}, "u": {"$inc": {"usage_count": 1}, "$setOnInsert": {"city": "$1", "user_id": {"$oid": "$2"}, "code": "$3"}}, "upsert": true}]}` (
    uniform.ref('fetch_users').city,
    uniform.ref('fetch_users')._id,
    uniform.ref('fetch_promo_codes')._id
  )
}

deseed {
  delete_user_promo_codes(type: exec) `{"delete": "user_promo_codes", "deletes": [{"q": {}, "limit": 0}]}`

  delete_vehicle_location_histories(type: exec) `{"delete": "vehicle_location_histories", "deletes": [{"q": {}, "limit": 0}]}`

  delete_rides(type: exec) `{"delete": "rides", "deletes": [{"q": {}, "limit": 0}]}`

  delete_vehicles(type: exec) `{"delete": "vehicles", "deletes": [{"q": {}, "limit": 0}]}`

  delete_promo_codes(type: exec) `{"delete": "promo_codes", "deletes": [{"q": {}, "limit": 0}]}`

  delete_users(type: exec) `{"delete": "users", "deletes": [{"q": {}, "limit": 0}]}`
}

down {
  drop_user_promo_codes(type: exec) `{"drop": "user_promo_codes"}`

  drop_vehicle_location_histories(type: exec) `{"drop": "vehicle_location_histories"}`

  drop_rides(type: exec) `{"drop": "rides"}`

  drop_vehicles(type: exec) `{"drop": "vehicles"}`

  drop_promo_codes(type: exec) `{"drop": "promo_codes"}`

  drop_users(type: exec) `{"drop": "users"}`
}

expect {
  error_rate < 1
}
