let customers  = 1000
let batch_size = 100
let value_size = 128

up {
  # Redis has no schema to create; PING keeps the lifecycle uniform.
  create(type: exec) `PING`
}

seed {
  # Each customer is a hash at customer:<n>. uniform.int returns a float,
  # so int() keeps the balance an integer for HINCRBY later.
  insert_customer(type: exec_batch, count: customers, size: batch_size)
    `HSET customer:$1 email $2 balance $3 blob $4` (
      seq(1, 1),
      gen('email'),
      int(uniform.int(1, 10000)),
      blob(value_size)
    )

  # A set of every customer id, so reads can pick one without a SCAN.
  index_customer(type: exec_batch, count: customers, size: batch_size)
    `SADD customer:ids $1` (seq(1, 1))
}

init {
  # SCAN rather than KEYS, which would block the server for the whole
  # sweep. The Lua wrapper walks the cursor and returns just the keys,
  # which edg reads as one row each under a "value" column.
  fetch_customers(type: query)
    `EVAL "local c=0 local out={} repeat local r=redis.call('SCAN',c,'MATCH',ARGV[1],'COUNT',1000) c=tonumber(r[1]) for _,k in ipairs(r[2]) do out[#out+1]=k end until c==0 return out" 0 customer:[0-9]*`
}

weights {
  read_customer  = 60
  credit_balance = 30
  random_member  = 10
}

run {
  read_customer(type: query) `HGETALL ${ref('fetch_customers').value}`

  # $1 appears twice: placeholders are inlined into the command text, so
  # repeating one is fine.
  credit_balance(type: exec) `HINCRBY customer:$1 balance $2` (
    int(uniform.int(1, customers)),
    int(uniform.int(1, 100))
  )

  random_member(type: query) `SRANDMEMBER customer:ids 5`
}

deseed {
  # UNLINK frees the keys on a background thread rather than blocking.
  delete_customers(type: exec)
    `EVAL "local c=0 repeat local r=redis.call('SCAN',c,'MATCH',ARGV[1],'COUNT',1000) c=tonumber(r[1]) for _,k in ipairs(r[2]) do redis.call('UNLINK',k) end until c==0 return 1" 0 customer:*`
}

down {
  drop(type: exec)
    `EVAL "local c=0 repeat local r=redis.call('SCAN',c,'MATCH',ARGV[1],'COUNT',1000) c=tonumber(r[1]) for _,k in ipairs(r[2]) do redis.call('UNLINK',k) end until c==0 return 1" 0 customer:*`
}
